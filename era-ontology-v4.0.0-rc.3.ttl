era:serviceCodeEnumType
	a owl:ObjectProperty ;
	rdfs:subPropertyOf era:telematicsObject_pg ;
	rdfs:label "Type of service code enum"@en ;
	rdfs:comment
		"""		
			A - 1st class seat
			AM - Business compartment 1st class
			AR - wheelchair seat 1st class
			B - 2nd class seat
			BR - wheelchair seat 1st class			
			S - Single with shower and  WC
			T - Double with shower and  WC
			L - Single
			M - Special
			N - Double
			P - T2
			Q - T3
			R - T4
			C - Couchette 1st class
			D - Couchette 2nd Class
			DR - wheelchair place in sleeping car			
			D4 - Couchette 2nd Class four-berth
			D5 - Couchette 2nd Class five-berth
			D6 - Couchette 2nd Class six-berth
			E - Sleeperette 1st Class
			F - Sleeperette 2nd Class
			G - Premium 1st Class
			H - Premium 2nd Class
			K - Euraffaires
			O - Vehicle parking place
			O3 - Vehicle loading place category 1 - 3
			O4 - motorcycle
			O5 - motorsycle with sidecar
			O8 - Vehicle loading place category 6 - 8
			OL - long trailer
			OS - short trailer
			SL - Single with shower and  WC and Double bed
			TL - Double with shower and WC and Double bed 
			U - T3 with shower and WC 
           X - Club 
           Y - Preferente 	
           Z - Tourist
			"""@en ,
		"Leaflet 918-1 element 308 first two digit - identical to ServiceCodeType but defined as enumeration."@en
		;
	era:inSkosConceptScheme <http://data.europa.eu/949/concepts/service-code-enum-type/ServiceCodeEnumType> ;
	era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/PropertyShape/ServiceCodeEnumType> ;
	era:usedInTelematics "true"^^xsd:boolean ;
	dcterms:created "2026-10-02T13:08:22+00:00"^^xsd:dateTime ;
	dcterms:references "https://gitlab.com/era-europa-eu/public/era-telematics-tsi/tsi_telematics/-/blob/V4.0.0/TD_B5_A2_xsd/"^^xsd:anyURI ;
	rdfs:range skos:Concept ;
	.

