era:dNvroll
	a
		owl:DatatypeProperty ,
		owl:FunctionalProperty
		;
	rdfs:subPropertyOf era:etcsNationalValuesDataParameter ;
	rdfs:label "D_NVROLL"@en ;
	rdfs:comment """Parameter used by the ETCS on-board to supervise the distance allowed to be travelled under the roll-away protection and the reverse movement protection, in metres
According to the specification referenced in Appendix A-1, index [C]"""@en ;
	era:applicable "Y/N/NYA" ;
	era:dependencyNote "A value has to be provided when ETCS is present (a value is provided on 1.1.1.3.2.1)."@en ;
	era:formatNote "A number of form at NNNNNN.N, from 0 to 327670" ;
	era:legalDeadline "12 months after publication of Article 7 Guide"@en ;
