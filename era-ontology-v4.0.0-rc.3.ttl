era:layoutServiceType
	a owl:ObjectProperty ;
	rdfs:subPropertyOf era:telematicsObject_pg ;
	rdfs:label "Type of layout service"@en ;
	rdfs:comment
		"""
					01 - Seats in trains
					02 - Couchettes in trains
					03 - Berths in trains
				"""@en ,
