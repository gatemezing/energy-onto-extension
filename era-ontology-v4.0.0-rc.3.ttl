	rdfs:label "Coordinating i m"@en ;
	rdfs:comment
		"Proposal from the RU, IM's will decide who will take the role."@en ,
		"The coordinating (leading) IM coordinates the agreement process for the IM’s. It is the primary point of contact for the RU’s. Certain critical stages in the international timetabling process are initiated by the leading IM, such as transfer the path request to path elaboration to involved IMs in order to prepare the offer with the partner-IMs. "@en
		;
	era:usedInTelematics "true"^^xsd:boolean ;
	dcterms:created "2026-10-02T13:08:22+00:00"^^xsd:dateTime ;
	dcterms:references "https://gitlab.com/era-europa-eu/public/era-telematics-tsi/tsi_telematics/-/blob/V4.0.0/TD_105_xsd/taf_cat_complete.xsd"^^xsd:anyURI ;
