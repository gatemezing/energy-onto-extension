era:gaugingCheckLocation
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf era:lineLayoutDataParameter ;
	rdfs:label "Railway location of particular points requiring specific checks"@en ;
	rdfs:comment 'Location of particular points requiring specific checks due to deviations from gauging referred to in parameter "Gauging"'@en ;
	era:XMLName "ILL_GaugeCheckLoc" ;
	era:applicable "Y/N" ;
	era:legalDeadline "16 January 2020"@en ;
	era:rinfIndex
		"1.1.1.1.3.1.2" ,
		"1.2.1.0.3.5"
		;
	era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/GaugingCheckLocation> ;
	era:usedInRCCCalculations "true"^^xsd:boolean ;
	dcterms:created "2020-07-29"^^xsd:date ;
	dcterms:modified
		"2024-01-08"^^xsd:date ,
		"2024-09-19"^^xsd:date ,
		"2025-02-28"^^xsd:date ,
		"2025-11-19"^^xsd:date
		;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf (
			era:CommonCharacteristicsSubset
			era:RunningTrack
		) ;
	] ;
	rdfs:isDefinedBy <http://data.europa.eu/949/> ;
	rdfs:range xsd:string ;
	vs:term_status "stable" ;
	skos:scopeNote """This parameter is applicable when the IM wants to highlight a particular point requiring checks and provide info via parameter 'Document with the transversal section of the particular points requiring specific checks'.

The railway location identifies the location of the structure in the system of reference of the line to which the track belongs.

The location (generally the distance from the origin of the line to the point of interest for the specific check) on a line is given in kilometres with decimals (precision of 0.001)."""@en ;
	.

era:gaugingProfile
	a owl:ObjectProperty ;
	rdfs:subPropertyOf
		era:lineLayoutObjParameter ,
		era:vehicleTechnicalObjCharacteristic ,
		era:vehicleTypeTechnicalObjectCharacteristic
		;
	rdfs:label "Gauging"@en ;
	rdfs:comment "Gauges as defined in European standard or other local gauges, including lower or upper part."@en ;
	era:XMLName "ILL_Gauging" ;
	era:applicable "Y" ;
	era:eratvIndex
		"3.1.2.3" ,
		"4.2.1"
		;
	era:evrIndex "11.9.1" ;
	era:inSkosConceptScheme <http://data.europa.eu/949/concepts/gaugings/GaugingProfiles> ;
	era:legalDeadline "16 January 2020"@en ;
	era:rinfIndex
		"1.1.1.1.3.1.1" ,
		"1.2.1.0.3.4"
		;
	era:shaclShapeValidationRule
		<http://data.europa.eu/949/eratv/shapes/GaugingProfile> ,
		<http://data.europa.eu/949/shapes/GaugingProfile> ,
		<http://data.europa.eu/949/shapes/GaugingProfileEVR> ,
		<http://data.europa.eu/949/shapes/InSkosConceptScheme>
		;
	era:usedInRCCCalculations "true"^^xsd:boolean ;
	dcterms:created "2020-07-29"^^xsd:date ;
	dcterms:modified
		"2023-03-14"^^xsd:date ,
		"2024-06-26"^^xsd:date ,
		"2024-09-19"^^xsd:date ,
		"2025-03-08"^^xsd:date ,
		"2025-03-12"^^xsd:date ,
		"2025-07-15"^^xsd:date
		;
	dcterms:source
		<https://data.europa.eu/eli/reg/2014/1299/2023-09-28> ,
		<https://data.europa.eu/eli/reg/2014/1302/2023-09-28>
		;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf (
			era:CommonCharacteristicsSubset
			era:Restriction
			era:RunningTrack
			era:VehicleType
		) ;
	] ;
	rdfs:isDefinedBy <http://data.europa.eu/949/> ;
	rdfs:range skos:Concept ;
	rdfs:seeAlso "https://www.era.europa.eu/system/files/2022-11/list_harmonised_national_restriction_codes_en.pdf"^^xsd:anyURI ;
	vs:term_status "stable" ;
	skos:altLabel "[ERATV] Reference profile"@en ;
	skos:editorialNote "Present and unchanged since <http://data.europa.eu/eli/dec_impl/2011/665>"@en ;
	skos:historyNote "former label: Vehicle kinematic gauge"@en ;
	skos:note "Harmonised restriction code 2.1"@en ;
	skos:scopeNote
		"""It is possible to include additional values than the already identified and included in the concept scheme. They will be introduced by the Agency on request via a process of change request.

                   UK in respect of the Northern Ireland have a reference profile, but defined based on national rule:
7.3.2.2 Specific case Ireland and UK for Northern Ireland ('P')
It is permissible for the reference profile of the upper and the lower part of the unit to be established in accordance with the national technical rules notified for this purpose.

                   See also: 
- Annex D1 OPE TSI
- INF TSI: 4.2.3.1, 4.2.3.2 """@en ,
		"""[ERATV] It is possible to include other values than the already identified and included in the concept scheme. They will be introduced by the Agency on request via a process of change request
                   EN15273-3: (2013)+A1:2016:  Annex C and Annex D
INF TSI: 4.2.3.1 """@en
		;
	.

era:gaugingTransversalDocument
	a owl:ObjectProperty ;
	rdfs:subPropertyOf era:lineLayoutObjParameter ;
	rdfs:label "Document with the transversal section of the particular points requiring specific checks"@en ;
	rdfs:comment 'Electronic document available from the IM stored by the Agency with the transversal section of the particular points requiring specific checks due to deviations from gauging referred to in parameter "Gauging". Where relevant, guidance for the check with the particular point may be attached to the document with the transversal section.'@en ;
	era:XMLName "ILL_GaugeCheckDocRef" ;
	era:applicable "Y/N" ;
	era:legalDeadline "16 January 2020"@en ;
	era:rinfIndex
		"1.1.1.1.3.1.3" ,
		"1.2.1.0.3.6"
		;
	era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/GaugingTransversalDocument> ;
	era:usedInRCCCalculations "true"^^xsd:boolean ;
	dcterms:created "2020-08-24"^^xsd:date ;
	dcterms:modified
		"2024-04-23"^^xsd:date ,
		"2024-09-19"^^xsd:date
		;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf (
			era:CommonCharacteristicsSubset
			era:RunningTrack
		) ;
	] ;
	rdfs:isDefinedBy <http://data.europa.eu/949/> ;
	rdfs:range era:Document ;
	vs:term_status "stable" ;
	skos:changeNote "Change from datatype property to object property in order to point to the class Document (reference document)"@en ;
	skos:scopeNote '''The value of this parameter should be either a reference to a file name or an external link to a document. 
If a file name is provided, the Infrastructure Manager (IM) must upload a document with the same file name using the "Reference Documents Management" functionality in the RINF application. The document must be in electronic format and available in two official EU languages. In this case, the parameter value must be repeated for each document. 
If an external link is provided, the IM must ensure that the document is available at the provided link.'''@en ;
	.

