era:positionOfPlaceType
	a owl:ObjectProperty ;
	rdfs:subPropertyOf era:telematicsObject_pg ;
	rdfs:label "Type of position of place"@en ;
	rdfs:comment
		"""
               W - window seat
               A - aile seat
               M - middle seat
               S - single window seat
               U - upper level berth or couchette
               I - middle level berth or couchette
               L - lower level berth or couchette
               """@en ,
		"corresponding to Leaflet 918 element 36 (new coding schema) "@en
		;
	era:inSkosConceptScheme <http://data.europa.eu/949/concepts/position-of-place-type/PositionOfPlaceType> ;
