	a
		owl:DatatypeProperty ,
		owl:FunctionalProperty
		;
	rdfs:subPropertyOf era:performanceDataParameter ;
	rdfs:label "Compliance of structures with the High Speed Load Model (HSLM)"@en ;
	rdfs:comment "For sections of line with a maximum permitted speed of 200 km/h or more. Information regarding the procedure to be used to perform the dynamic compatibility check."@en ;
	era:XMLName "IPP_HSLMCompliant" ;
	era:applicable "Y/N" ;
	era:legalDeadline "16 January 2020"@en ;
	era:rinfIndex "1.1.1.1.2.4.2" ;
	era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/HighSpeedLoadModelCompliance> ;
