era:PassengerCategory
	a owl:Class ;
	rdfs:label "Passenger Category"@en ;
	rdfs:comment """Passenger Category predefines a set of passenger specification properties that result to offer of a specific passenger type. 
`title` is the localized name of the passenger category and `specification` describes exact passenger specification that may results into offer for selected passenger category. Passenger category specification doesn't guarantee availability of expected passenger type on offered trip. `appliedPassengerType` must always be checked in the offer response.
"""@en ;
	era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/NodeShape/PassengerCategory> ;
	era:usedInTelematics "true"^^xsd:boolean ;
