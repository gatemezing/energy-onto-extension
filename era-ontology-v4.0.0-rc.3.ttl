	a
		owl:DatatypeProperty ,
		owl:FunctionalProperty
		;
	rdfs:subPropertyOf era:telematicsData_pg ;
	rdfs:label "Layout reply code"@en ;
	rdfs:comment
		"""error reply code:           

    001 - syntax error in request
    010 - no layouts available
    100 - technical error 
    110 - service temporarily unavailable
"""@en ,
		"""the reply code might not be included in case of a reply to the indicate an alternative system

element 63"""@en
		;
	era:usedInTelematics "true"^^xsd:boolean ;
