	rdfs:isDefinedBy <http://data.europa.eu/949/> ;
	rdfs:range skos:Concept ;
	rdfs:seeAlso
		"https://eur-lex.europa.eu/eli/reg_impl/2023/1695/oj"^^xsd:anyURI ,
		"https://www.era.europa.eu/sites/default/files/2025-06/ag%20era_ertms_0033281v5_v1.pdf"^^xsd:anyURI
