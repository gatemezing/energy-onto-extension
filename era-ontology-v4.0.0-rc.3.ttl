era:informationOnly
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf era:telematicsData_pg ;
	rdfs:label "Information only"@en ;
	rdfs:comment
		"In case of an informationOnly Reply the reply messages does not cancel the reservation. It priovides information on what would happen in case the cancellation would be made."@en ,
		"In case of an informationOnly Reply the reply messages does not provide a new reservation. It does not include a valid reference number. There must not be accountings for these transactions. There must not be correction or synchronization requests made related to these transactions."@en ,
		"In case of an informationOnly Reply the reply messages does not provide a reservation. It does not include a valid reference number. There must not be accountings for these transactions. There must not be correction or synchronization requests made related to these transactions."@en ,
		"In case of messages with this flag the reservation or cancellation is evaluated identical to a real booking, but the booking or cancellation is not made persistent. The reply messages might not include a valid reference number. There must not be accountings for these transactions. There must not be correction or synchronization requests made related to these transactions."@en
		;
	era:usedInTelematics "true"^^xsd:boolean ;
	dcterms:created "2026-10-02T13:08:22+00:00"^^xsd:dateTime ;
	dcterms:references "https://gitlab.com/era-europa-eu/public/era-telematics-tsi/tsi_telematics/-/blob/V4.0.0/TD_B5_A2_xsd/"^^xsd:anyURI ;
	rdfs:domain [
		a owl:Class ;
		era:usedInTelematics "true"^^xsd:boolean ;
		dcterms:created "2026-10-02T13:08:22+00:00"^^xsd:dateTime ;
		dcterms:references "https://gitlab.com/era-europa-eu/public/era-telematics-tsi/tsi_telematics/-/blob/V4.0.0/TD_B5_A2_xsd/"^^xsd:anyURI ;
		owl:unionOf (
			era:UicCancelReply
			era:UicCancelRequest
			era:PartialCancelReply
			era:PartialCancelRequest
			era:ReservationReply
			era:ReservationRequest
		) ;
	] ;
	rdfs:range xsd:boolean ;
	.

