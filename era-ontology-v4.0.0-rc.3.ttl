era:tsiMagneticFields
	a
		owl:DatatypeProperty ,
		owl:FunctionalProperty
		;
	rdfs:subPropertyOf era:relatedElectromagneticInterferencesDataParameter ;
	rdfs:label "Existence and TSI compliance of rules for magnetic fields emitted by a vehicle"@en ;
	rdfs:comment "Indication whether rules exist and are compliant with the TSI."@en ;
	era:XMLName "CEI_TSIMagneticFields" ;
	era:applicable "Y/N/NYA" ;
	era:dependencyNote "Applicable ( Y ) only when for parameter 1.1.1.3.7.1 the selected option is wheel detector. The parameter is not applicable when the rules do not exist."@en ;
	era:formatNote "Y/N" ;
	era:legalDeadline
		"12 months after publication of Article 7 Guide for OP tracks"@en ,
		"In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en
		;
	era:rinfIndex
		"1.1.1.3.9.1" ,
		"1.2.1.1.8.1"
		;
	era:shaclShapeValidationRule
		<http://data.europa.eu/949/shapes/TsiMagneticFields> ,
		<http://data.europa.eu/949/shapes/TsiMagneticFieldsApplicability>
		;
	dcterms:created "2024-04-18"^^xsd:date ;
	dcterms:modified
		"2024-09-19"^^xsd:date ,
		"2025-02-18"^^xsd:date ,
		"2025-02-28"^^xsd:date
		;
	dcterms:relation era:trainDetectionSystemType ;
	dcterms:replaces era:TSIMagneticFields ;
	dcterms:source <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf (
			era:CommonCharacteristicsSubset
			era:RunningTrack
		) ;
	] ;
	rdfs:isDefinedBy <http://data.europa.eu/949/> ;
	rdfs:range xsd:boolean ;
	rdfs:seeAlso "https://www.era.europa.eu/sites/default/files/2025-06/ag%20era_ertms_0033281v5_v1.pdf"^^xsd:anyURI ;
	vs:term_status "stable" ;
	skos:scopeNote """The electromagnetic fields generated by rolling stock can interfere with the operation of axle counters and wheel detectors. 
                      'True' means the rules exist and are compliant with the frequency management specified in the TSI.
                      'False' means the rules exist and are not compliant with the frequency management specified in the TSI.

                      Verification of compliance with TSI includes application of notified national rules (when they exist) in case of part covered by open point."""@en ;
	.

