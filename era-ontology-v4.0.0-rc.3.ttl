era:Fulfillment
	a owl:Class ;
	rdfs:label "Fulfillment"@en ;
	rdfs:comment """A fulfillment is a document (or part of a document in distributor mode) that
- allows the passenger to prove its travel right
- provides easier access to trains and stations
- allows an exchange for other services (voucher)
A fulfillment refers to services of one or multiple offer parts or a fare (distributor mode).
"""@en ;
	era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/NodeShape/Fulfillment> ;
	era:usedInTelematics "true"^^xsd:boolean ;
	dcterms:created "2026-10-02T13:09:07+00:00"^^xsd:dateTime ;
	dcterms:references "https://osdm.io/osdm/update/2026/03/25/OSDM-V3.8-released"^^xsd:anyURI ;
	.

