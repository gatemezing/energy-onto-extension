	rdfs:comment "Nominal maximum operational speed on the line as a result of infrastructure, energy and control, command signalling subsystem characteristics expressed in kilometres/hour."@en ;
	era:XMLName "IPP_MaxSpeed" ;
	era:applicable "Y/N" ;
	era:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
	era:rinfIndex "1.1.1.1.2.5" ;
	era:shaclShapeValidationRule
