era:canonicalURI
	a owl:AnnotationProperty ;
	rdfs:label "Canonical URI"@en ;
	rdfs:comment """The canonical URI is defined for each instance of an Infrastructure element, e.g. section of line, operational point, track, tunnel, siding.
Objects of the infrastructure generated through RML mappings include (when provided) their validity start and end dates. With its identifier, plus all identifiers of its \"parent\" elements, and its validity dates, a hash URI is generated.
The canonical URI is the element's URI with its identifiers and without the validity dates. All of the hash URIs of an element point to its canonical URI.
Additionally, SoLs point to the canonical URIs of their start OP and end OP."""@en ;
	era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/CanonicalURI> ;
	dcterms:created "2022-12-13"^^xsd:date ;
	dcterms:modified
		"2024-02-06"^^xsd:date ,
		"2026-02-27"^^xsd:date
		;
	rdfs:domain era:InfrastructureElement ;
	rdfs:isDefinedBy <http://data.europa.eu/949/> ;
	rdfs:range rdfs:Resource ;
	.

era:cantDefficiency
	a owl:DatatypeProperty ;
	rdfs:label "Cant defficiency"@en ;
	rdfs:comment "Cant deficiency (maximum uncompensated lateral acceleration) for which the vehicle has been assessed. For dual gauge vehicles values for each gauge have to be indicated."@en ;
	dcterms:created "2021-08-26"^^xsd:date ;
	dcterms:isReplacedBy era:assessedCantDeficiency ;
	dcterms:modified
		"2021-08-26"^^xsd:date ,
		"2024-06-26"^^xsd:date ,
		"2025-03-05"^^xsd:date
		;
	rdfs:isDefinedBy <http://data.europa.eu/949/> ;
	owl:deprecated "true"^^xsd:boolean ;
	vs:term_status "stable" ;
	.

era:cantDeficiency
	a
		owl:DatatypeProperty ,
		owl:FunctionalProperty
		;
	rdfs:subPropertyOf era:trackDataParameter ;
	rdfs:label "Cant deficiency"@en ;
	rdfs:comment "Maximum cant deficiency expressed in millimetres defined as difference between the applied cant and a higher equilibrium cant the line has been designed for."@en ;
	era:XMLName "ITP_CantDeficiency" ;
	era:applicable "Y" ;
	era:formatNote "+/-NNN" ;
	era:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
	era:rinfIndex "1.1.1.1.4.2" ;
	era:shaclShapeValidationRule
		<http://data.europa.eu/949/shapes/CantDeficiency> ,
		<http://data.europa.eu/949/shapes/CantDeficiencyRequiredForSoL>
		;
	era:unitOfMeasure unit:MilliM ;
	era:usedInRCCCalculations "true"^^xsd:boolean ;
	dcterms:created "2020-08-24"^^xsd:date ;
	dcterms:modified
		"2021-09-10"^^xsd:date ,
		"2024-09-19"^^xsd:date ,
		"2025-02-28"^^xsd:date
		;
	dcterms:source <http://data.europa.eu/eli/reg/2014/1299/2023-09-28> ;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf (
			era:CommonCharacteristicsSubset
			era:RunningTrack
		) ;
	] ;
	rdfs:isDefinedBy <http://data.europa.eu/949/> ;
	rdfs:range xsd:integer ;
	rdfs:seeAlso "INF TSI: 4.2.4.3" ;
	vs:term_status "stable" ;
	skos:scopeNote "In case of positive value of cant deficiency or zero symbol  '+' shall be applied. In case of negative cant deficiency symbol '-' has to be selected. Value of the cant deficiency shall be given in millimetres. In case of lateral uncompensated acceleration on a 1435 mm track gauge of 1.0 m/s2 the value of 153 mm may be published."@en ;
	.

era:cantDeficiencyBasicSSP
	a
		owl:ObjectProperty ,
		owl:FunctionalProperty
		;
	rdfs:subPropertyOf era:tsiCompliantTrainProtectionSystemObjParameter ;
	rdfs:label "Cant Deficiency used for the basic SSP"@en ;
	rdfs:comment 'Essential information for railway undertakings with a worse (lower) tolerated cant deficiency than those for which the ETCS trackside provides SSP (Static Speed Profiles) in conjunction with parameter "Other Cant Deficiency train categories for which the ETCS trackside is configured to provide SSP".'@en ;
	era:applicable "Y/N/NYA" ;
	era:dependencyNote "A value has to be provided when ETCS is present (a value is provided on 1.1.1.3.2.1)."@en ;
	era:inSkosConceptScheme <http://data.europa.eu/949/concepts/cant-deficiencies/CantDeficiencies> ;
	era:legalDeadline "12 months after publication of Article 7 Guide"@en ;
	era:rinfIndex
		"1.1.1.3.2.14" ,
		"1.2.1.1.1.14"
		;
	era:shaclShapeValidationRule
		<http://data.europa.eu/949/shapes/CantDeficiencyBasicSSP> ,
		<http://data.europa.eu/949/shapes/CantDeficiencyBasicSSPApplicability> ,
		<http://data.europa.eu/949/shapes/InSkosConceptScheme>
		;
	era:tsiOPEAppendixD3Index "1.3" ;
	era:unitOfMeasure unit:MilliM ;
	dcterms:created "2023-03-14"^^xsd:date ;
	dcterms:modified
		"2024-01-08"^^xsd:date ,
		"2024-04-18"^^xsd:date ,
		"2024-09-19"^^xsd:date ,
		"2025-02-28"^^xsd:date
		;
	dcterms:relation
		era:etcsLevelType ,
		era:otherCantDeficiencyBasicSSP
		;
	dcterms:source <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf (
			era:CommonCharacteristicsSubset
			era:RunningTrack
		) ;
	] ;
	rdfs:isDefinedBy <http://data.europa.eu/949/> ;
	rdfs:range skos:Concept ;
	rdfs:seeAlso "https://www.era.europa.eu/domains/technical-specifications-interoperability/control-command-and-signalling-tsi_en#oe-content-paragraph-1632"^^xsd:anyURI ;
	vs:term_status "stable" ;
	skos:scopeNote '''The values indicated in millimetres correspond to tracks with UIC gauge. For tracks with a gauge different from UIC, the values provided here are the equivalent ones for UIC gauge, as the actual physical cant deficiency values differ. Please refer to parameter 1.1.1.1.4.2 for more details.
                           Subset-026 (3.11.3.2.1.1) definition:
a) The "Cant Deficiency" SSP categories: the cant deficiency value assigned to one category shall define the maximum speed, determined by suspension design, at which a particular train can traverse a curve and thus can be used to set a specific speed limit in a curve with regards to this category.'''@en ;
	.

