era:opEnd
	a
		owl:ObjectProperty ,
		owl:FunctionalProperty
		;
	rdfs:subPropertyOf era:solGenericObjParameter ;
	rdfs:label "Operational point at end of section of line"@en ;
	rdfs:comment "Operational point at the end of section of line (kilometres increasing from start OP to the end OP)."@en ;
	era:XMLName "SOLOPEnd" ;
	era:applicable "Y" ;
	era:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
	era:rinfIndex "1.1.0.0.0.4" ;
	era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/OpEnd> ;
	era:tsiOPEAppendixD2Index "3.1.2" ;
	dcterms:created "2021-09-09"^^xsd:date ;
	dcterms:modified
		"2024-01-08"^^xsd:date ,
		"2024-09-19"^^xsd:date ,
		"2025-03-11"^^xsd:date
		;
	dcterms:source <http://data.europa.eu/eli/reg_impl/2019/773/oj> ;
	rdfs:domain era:SectionOfLine ;
	rdfs:isDefinedBy <http://data.europa.eu/949/> ;
	rdfs:range era:OperationalPoint ;
	vs:term_status "stable" ;
	skos:scopeNote """Each SoL may have only one end OP, and each OP has unique OP ID within the MS. The “uniqueOPID” is defined in parameter 1.2.0.0.0.2.
Each SoL has the principal direction of the traffic defined by increasing kilometres running from the start OP to the end OP.
That is why the end OP is always located at highest kilometre of the line within the SoL.
No validation will be performed by RINF application regarding which is the start and which the end OP. This requires IM's verification. """@en ;
	.

