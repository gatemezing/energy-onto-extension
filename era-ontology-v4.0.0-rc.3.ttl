era:ECDeclaration
	a owl:Class ;
	rdfs:subClassOf vpa:EvidenceDocument ;
	rdfs:label "EC Declaration of Verification/Conformity"@en ;
	rdfs:comment "EC Declaration of Verification/Conformity/Suitability for Use, as issued by an Applicant in the process of certification/verification activities for IC's or subsystems."@en ;
	dcterms:created "2025-04-04"^^xsd:date ;
	dcterms:source
		<https://eur-lex.europa.eu/eli/dir/2016/797/2020-05-28#art_10> ,
		<https://eur-lex.europa.eu/eli/dir/2016/797/2020-05-28#art_15> ,
		<https://eur-lex.europa.eu/eli/dir/2016/797/2020-05-28#art_9>
		;
	rdfs:isDefinedBy <http://data.europa.eu/949/> ;
	rdfs:seeAlso "https://nb-rail.eu/official-documents"^^xsd:anyURI ;
	vs:term_status "stable" ;
	skos:scopeNote """Every EC Declaration is the outcome of a process assisted by a recognised/accredited body (`vpa:AppropriateBody`) which is allowed to issue the supporting
CLD's to the `vpa:RequestingBody` needing it for a specific purpose, as defined in the IOD or SD.
EC Declarations MUST refer to the required CLDs using `dcterms:requires` which can be grouped as `vpa:Evidence` in authorisation/registration processes."""@en ;
	.

