era:layoutPlaceRemark
	a owl:ObjectProperty ;
	rdfs:subPropertyOf era:telematicsObject_pg ;
	rdfs:label "Layout place remark"@en ;
	rdfs:comment """remark on a place:
				value 1: place might have a table
				value 2: table at the place might be missing 				 
				value 3: place might have a different direction
			 value 4: place might have a table and a different direction
				value 5: table at the place might be missing and place might have a different direction
			value 6: place might be in compartment

value 7: 	place might be in open space			  
					"""@en ;
	era:usedInTelematics "true"^^xsd:boolean ;
	dcterms:created "2026-10-02T13:08:22+00:00"^^xsd:dateTime ;
	dcterms:references "https://gitlab.com/era-europa-eu/public/era-telematics-tsi/tsi_telematics/-/blob/V4.0.0/TD_B5_A2_xsd/"^^xsd:anyURI ;
