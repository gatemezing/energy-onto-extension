era:Reimbursement
	a owl:Class ;
	rdfs:label "Reimbursement"@en ;
	rdfs:comment """Customers who have bought a ticket which allows reimbursement and which have not traveled or traveled partially only can claim to be reimbursed. The customer must prove that he has not or only partially used the ticket. A partial use might be a only a part of the trip was traveled or only some of the travelers were traveling or a combination of both.
"""@en ;
	era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/NodeShape/Reimbursement> ;
	era:usedInTelematics "true"^^xsd:boolean ;
	dcterms:created "2026-10-02T13:09:07+00:00"^^xsd:dateTime ;
	dcterms:references "https://osdm.io/osdm/update/2026/03/25/OSDM-V3.8-released"^^xsd:anyURI ;
	.

