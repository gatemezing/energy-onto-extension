era:boatCategoryType
	a owl:ObjectProperty ;
	rdfs:subPropertyOf era:telematicsObject_pg ;
	rdfs:label "Type of boat category"@en ;
	rdfs:comment
		"""
			1 - boat less than 3,81 m in length and with a roof width up to 1,35 m.
			2 - boat between 3,81 m up to 4,42 m in length and with a roof width up to 1,35 m
			3 - boat more than 4,42 m in length and with a roof width up to 1,35 m
			6 - boat less than 3,81 m in length and with a roof width between 1,36 m and 1,55 m
			7 - boat between 3,81 m and 4,42 m in length and with a roof width between 1,36 m and 1,55 m
			8 - boat more than 4,42 m in length and with a roof width between 1,36 m and 1,55 m
			"""@en ,
		"Leaflet 918 element 29"@en
		;
	era:inSkosConceptScheme <http://data.europa.eu/949/concepts/boat-category-type/BoatCategoryType> ;
	era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/PropertyShape/BoatCategoryType> ;
	era:usedInTelematics "true"^^xsd:boolean ;
	dcterms:created "2026-10-02T13:08:22+00:00"^^xsd:dateTime ;
	dcterms:references "https://gitlab.com/era-europa-eu/public/era-telematics-tsi/tsi_telematics/-/blob/V4.0.0/TD_B5_A2_xsd/"^^xsd:anyURI ;
	rdfs:range skos:Concept ;
	.

