	dcterms:modified
		"2024-01-08"^^xsd:date ,
		"2024-09-19"^^xsd:date ,
		"2025-02-28"^^xsd:date ,
		"2025-03-12"^^xsd:date ,
		"2025-07-15"^^xsd:date
		;
	dcterms:source <http://data.europa.eu/eli/reg/2014/1299/2023-09-28> ;
	rdfs:domain [
		a owl:Class ;
