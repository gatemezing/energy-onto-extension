era:alternativeServiceCodeType
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf era:telematicsData_pg ;
	rdfs:label "Type of alternative service code"@en ;
	rdfs:comment
		"""
			A - Seats 1st Class smoking compartment coach
			B - Seats 1st Class smoking open saloon coach
			C - Seats 1st Class non-smoking compartment coach
			D - Seats 1st Class non-smoking open saloon coach
			E - Seats 2nd Class smoking compartment coach
			F - Seats 2nd Class non-smoking compartment coach
			G - Seats 2nd Class smoking open saloon coach
			H - Seats with meal at seat 1st Class smoking
			T - Seats with meal at seat 1st Class non-smoking
			J - Seats 2nd Class non-smoking open saloon coach
			K - Seats with meal at seat 2nd Class smoking
			L - Seats with meal at seat 2nd Class non-smoking
			M - Couchette 2nd Class smoking, four-berth
			N - Couchette 1st Class smoking
			O - Couchette 1st Class non-smoking
			P - Couchette 2nd Class non-smoking, four-berth
			Q - Couchette 2nd Class smoking
			R - Couchette 2nd Class non-smoking
			S - Single sleeping berth
			T - Special sleeping berth
			U - Double sleeping berth
			V - T2 sleeping berth
			W - T3 sleeping berth
			X - T4 sleeping berth
			Y - Restaurant car
			"""@en ,
		"Leaflet 918 element 62"@en
		;
	era:usedInTelematics "true"^^xsd:boolean ;
	dcterms:created "2026-10-02T13:08:22+00:00"^^xsd:dateTime ;
	dcterms:references "https://gitlab.com/era-europa-eu/public/era-telematics-tsi/tsi_telematics/-/blob/V4.0.0/TD_B5_A2_xsd/"^^xsd:anyURI ;
	rdfs:range xsd:string ;
	.

