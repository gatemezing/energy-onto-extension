	era:evrIndex "11.9.1" ;
	era:inSkosConceptScheme <http://data.europa.eu/949/concepts/nominal-track-gauges/NominalTrackGauges> ;
	era:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
	era:rinfIndex
		"1.1.1.1.4.1" ,
		"1.2.1.0.4.1"
		;
	era:shaclShapeValidationRule
		<http://data.europa.eu/949/eratv/shapes/WheelSetGauge> ,
		<http://data.europa.eu/949/shapes/InSkosConceptScheme> ,
		<http://data.europa.eu/949/shapes/WheelSetGauge> ,
		<http://data.europa.eu/949/shapes/WheelSetGaugeEVR> ,
		<http://data.europa.eu/949/shapes/WheelSetGaugeSKOS>
		;
	era:usedInRCCCalculations "true"^^xsd:boolean ;
