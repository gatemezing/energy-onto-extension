era:allocatedCoachTypeType
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf era:telematicsData_pg ;
	rdfs:label "Type of allocated coach type"@en ;
	rdfs:comment
		"""
					1 - In a side-corridor coach
					2 - In a central-gangway coach
					3 - In a coach with central-gangway and side corridor
					4 - In a coach with meals at seat
					5 - Seat at table in the central-gangway coach
					6 - wheelchair places with an additional seat
					14 - In air-conditioned couchette or sleeping ca
					16 - In panorama coach
					17 - In compartment with shower and WC
					18 - In compartment with shower
					19 - In Sleeperette
					21 -Manager compartment/business
					22 - Video compartment
					23 - Conference room
					24 - Bicycle compartment (including seat)
					25 - EURAFFAIRES
					26 - Sleeping car with shower
					27 - Club
					28 - Preferente
					29 - Tourist
					31 - Pram compartment
					32 - Only bicycle storage space
					33 - Cabin8
					35 - Only tandem-bicycle storage space
					39 - Cabin-couchette coach
					52 - Silence
					53 - Office
					56 - wheelchair places without an additional seat
					"""@en ,
		"Leaflet 918 element 51 digit one and  two"@en
		;
	era:usedInTelematics "true"^^xsd:boolean ;
	dcterms:created "2026-10-02T13:08:22+00:00"^^xsd:dateTime ;
	dcterms:references "https://gitlab.com/era-europa-eu/public/era-telematics-tsi/tsi_telematics/-/blob/V4.0.0/TD_B5_A2_xsd/"^^xsd:anyURI ;
	rdfs:range xsd:int ;
	.

era:allocatedCompartmentTypeType
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf era:telematicsData_pg ;
	rdfs:label "Type of allocated compartment type"@en ;
	rdfs:comment
		"""
					1 - Passenger needing assistance/disabled passenger
					2 - Unaccompanied child/young person
					7 - Woman and child compartment
					8 - places with easy access - PRMs 
					9 - Complete compartment
					10 - Family compartment
					11 - Quiet compartment
					12 - Conference compartment
					13 - Four-berth couchette compartment
					15 - Compartment without animals
					20 - Couchette coach without equipment
					34 - Seat near restaurant car
					36 - Seat with drink
					37 - Seat with meal
					38 - Seat with electric power point
					40 - PREMIUM
					41 - Place with animals
					42 - Breakfast included
					43 - Area with amplifiers for mobile telephones
					44 - SOLO (individual seat)
					45 - Duo face to face (2 seats facing)
					46 - Duo side by side (2 seats side by side)
					47 - Club Duo (2 seats facing in a separate compartment) 
					48 - Club 4 (4 seats facing normally 1st Class)
					49 - Carré (4 seats facing normally 2nd Class) 
					50 - Salon (6 seats facing in a separate compartment)
					51 - Kiosque (special seat in the edge area)
					54 - Five-berth couchette compartment
					55 - Double bed (Suite DeLuxe)
					57 - place close to place with animals
					"""@en ,
		"Leaflet 918 element 51 third and fourth digit"@en
		;
	era:usedInTelematics "true"^^xsd:boolean ;
	dcterms:created "2026-10-02T13:08:22+00:00"^^xsd:dateTime ;
	dcterms:references "https://gitlab.com/era-europa-eu/public/era-telematics-tsi/tsi_telematics/-/blob/V4.0.0/TD_B5_A2_xsd/"^^xsd:anyURI ;
	rdfs:range xsd:int ;
	.

era:allocatedContingentTypeType
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf era:telematicsData_pg ;
	rdfs:label "Type of allocated contingent type"@en ;
	rdfs:comment
		"""
					11 - Railtour (at present SBB - FS offer)
					12 - Frantour (at present SNCF offer)
					13 - Wasteels (at present SBB - FS offer)
					14 - CIT (Compagnia Italiana Turismo) (at present SBB - FS offer)
					15 - Geerinck (at present SNCF - SBB offer)
					16 - Trans (at present SNCF offer) 
					30 - Female compartment in couchette coach
			"""@en ,
		"Leaflet 918 element 51 fith and sixth digit"@en
		;
	era:usedInTelematics "true"^^xsd:boolean ;
	dcterms:created "2026-10-02T13:08:22+00:00"^^xsd:dateTime ;
	dcterms:references "https://gitlab.com/era-europa-eu/public/era-telematics-tsi/tsi_telematics/-/blob/V4.0.0/TD_B5_A2_xsd/"^^xsd:anyURI ;
	rdfs:range xsd:int ;
	.

