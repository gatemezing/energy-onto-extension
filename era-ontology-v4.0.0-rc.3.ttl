era:umax2
	a
		owl:DatatypeProperty ,
		owl:FunctionalProperty
		;
	rdfs:subPropertyOf era:contactLineSystemDataParameter ;
	rdfs:label "Umax2 for the French network"@en ;
	rdfs:comment "Highest non-permanent voltage (Umax2) for France on lines not compliant with values defined in the EN50163:2004+A1:2007+A2:2020+A3:2022"@en ;
	era:XMLName "ECS_Umax2" ;
	era:applicable "Y/N" ;
	era:dependencyNote "When `not electrified` is chosen in parameter 1.1.1.2.2.1.1, then this parameter is not applicable."@en ;
	era:legalDeadline "16 January 2020"@en ;
	era:rinfIndex "1.1.1.2.2.1.3" ;
	era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/Umax2> ;
	era:unitOfMeasure unit:V ;
	era:usedInRCCCalculations "true"^^xsd:boolean ;
