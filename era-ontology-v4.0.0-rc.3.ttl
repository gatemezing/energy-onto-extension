era:negativeReply
	a
		owl:ObjectProperty ,
		owl:FunctionalProperty
		;
	rdfs:subPropertyOf era:telematicsObject_pg ;
	rdfs:label "Negative reply"@en ;
	rdfs:comment
		"- Booking not found"@en ,
		"""- Booking not found
- Booking already cancelled
- Booking outdated
- No Security Features supported (new)
- Personal Data missing on the booking (new)"""@en ,
		"""- Booking not found (..)
- Booking already cancelled (..)
- Booking outdated (departure date is in the past) (..)
- Provided Data is incomplete or outdated (new) 
        (e.g. passport is expired at the travel date)
- Number of passengers provided does not match requirements (new)
- Exchange of passenger(s) not allowed (new)
        (corrections are always allowed) """@en ,
		"- TODO new error code in case no coach is available for graphical reservatiopn"@en
		;
	era:usedInTelematics "true"^^xsd:boolean ;
	dcterms:created "2026-10-02T13:08:22+00:00"^^xsd:dateTime ;
	dcterms:references "https://gitlab.com/era-europa-eu/public/era-telematics-tsi/tsi_telematics/-/blob/V4.0.0/TD_B5_A2_xsd/"^^xsd:anyURI ;
	rdfs:domain [
		a owl:Class ;
		era:usedInTelematics "true"^^xsd:boolean ;
		dcterms:created "2026-10-02T13:08:22+00:00"^^xsd:dateTime ;
		dcterms:references "https://gitlab.com/era-europa-eu/public/era-telematics-tsi/tsi_telematics/-/blob/V4.0.0/TD_B5_A2_xsd/"^^xsd:anyURI ;
		owl:unionOf (
			era:AddPersonalDataReply
			era:AvailabilityGBReply
			era:UicAvailabilityReply
			era:UicCancelReply
			era:GetStoredPersonalDataReply
			era:GetTicketSecurityReply
			era:PartialCancelReply
			era:RollbackReply
		) ;
	] ;
	rdfs:range [
		a owl:Class ;
		era:usedInTelematics "true"^^xsd:boolean ;
		dcterms:created "2026-10-02T13:08:22+00:00"^^xsd:dateTime ;
		dcterms:references "https://gitlab.com/era-europa-eu/public/era-telematics-tsi/tsi_telematics/-/blob/V4.0.0/TD_B5_A2_xsd/"^^xsd:anyURI ;
