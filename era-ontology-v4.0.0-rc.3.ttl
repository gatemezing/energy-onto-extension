era:PrimaryLocation
	a owl:Class ;
	rdfs:subClassOf
		era:InfrastructureElement ,
		[
			a owl:Restriction ;
			owl:onProperty era:netReference ;
			owl:allValuesFrom era:NetPointReference ;
		]
		;
	rdfs:label "Primary Location"@en ;
	rdfs:comment
		"Indication of the Railway location in TSI context"@en ,
		"Indication of the Railway or Customer Location"@en ,
		"""Primary Location is a place used by IM to define a path for a train in TAF/TAP TSI framework/messages. This location is a rail point inside the rail network where train starts, ends, stops, or runs through or change line. This location must be managed by an Infrastructure Manager (IM) identified by company code.

Primary locations are identified by single and unique Primary Location codes. Primary location code is allocated based on processes defined by national entity. Primary location codes are used in any kind of TAF/TAP communication.
"""@en
		;
	era:shaclShapeValidationRule
		<http://data.europa.eu/949/shapes/NodeShape/LocationIdent> ,
		<http://data.europa.eu/949/shapes/PrimaryLocationShape>
		;
	era:usedInTelematics "true"^^xsd:boolean ;
	dcterms:created "2026-10-02T13:08:22+00:00"^^xsd:dateTime ;
	dcterms:modified
		"2024-10-28"^^xsd:date ,
		"2025-03-01"^^xsd:date ,
		"2025-06-06"^^xsd:date
		;
	dcterms:references
		"https://gitlab.com/era-europa-eu/public/era-telematics-tsi/tsi_telematics/-/blob/V4.0.0/TD_105_xsd/taf_cat_complete.xsd"^^xsd:anyURI ,
		"https://gitlab.com/era-europa-eu/public/era-telematics-tsi/tsi_telematics/-/blob/V4.0.0/TD_B5_A2_xsd/"^^xsd:anyURI
		;
	rdfs:isDefinedBy <http://data.europa.eu/949/> ;
	rdfs:seeAlso
		"Handbook 9.3.3 / page 60" ,
		"http://taf-jsg.info/wp-content/uploads/2025/07/JSG-Handbook-3.7-with-XSD-3.5.1.0.pdf"^^xsd:anyURI
		;
	owl:disjointWith
		era:RadioBlockCenter ,
		era:SectionOfLine ,
		era:Signal ,
		era:SpecialArea ,
		era:SubsidiaryLocation ,
		era:Switch ,
		era:Track ,
		era:Tunnel
		;
	skos:example "Primary locations are for example: stations, yards, halts, handover points, border points, open access terminals. "@en ;
	.

