era:voiceRadioCompatible
	a owl:ObjectProperty ;
	rdfs:subPropertyOf
		era:tsiCompliantRadioObjParameter ,
		era:vehicleTypeTechnicalObjectCharacteristic
		;
	rdfs:label "Radio system compatibility voice"@en ;
	rdfs:comment "Radio requirements used for demonstrating technical compatibility voice."@en ;
	era:XMLName "CRG_RadioCompVoice" ;
	era:applicable "Y/N/NYA" ;
	era:dependencyNote """GSM-R must be installed for this parameter to be applicable.
In case of RSC-EU-0 or None, no other values are allowed."""@en ;
	era:eratvIndex "4.13.2.5" ;
	era:inSkosConceptScheme <http://data.europa.eu/949/concepts/radio-system-compatibilities-voice/RadioSystemCompatibilitiesVoice> ;
	era:legalDeadline
		"12 months after publication of Article 7 Guide for OP tracks"@en ,
		"16 January 2020"@en
		;
	era:rinfIndex
		"1.1.1.3.3.9" ,
		"1.2.1.1.2.9"
		;
	era:shaclShapeValidationRule
		<http://data.europa.eu/949/eratv/shapes/VoiceRadioCompatible> ,
		<http://data.europa.eu/949/shapes/InSkosConceptScheme> ,
		<http://data.europa.eu/949/shapes/VoiceRadioCompatible> ,
		<http://data.europa.eu/949/shapes/VoiceRadioCompatibleApplicability> ,
		<http://data.europa.eu/949/shapes/VoiceRadioCompatibleSKOS>
		;
	dcterms:created "2020-08-31"^^xsd:date ;
	dcterms:isRequiredBy
		<http://data.europa.eu/eli/dec_impl/2011/665/2019-06-16> ,
		<http://data.europa.eu/eli/dec_impl/2011/665/2021-05-18> ,
		<http://data.europa.eu/eli/dec_impl/2011/665/2023-09-08>
		;
	dcterms:modified
		"2021-09-12"^^xsd:date ,
		"2024-04-18"^^xsd:date ,
		"2024-09-19"^^xsd:date
		;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf (
			era:CommonCharacteristicsSubset
			era:RunningTrack
			era:VehicleType
		) ;
	] ;
	rdfs:isDefinedBy <http://data.europa.eu/949/> ;
	rdfs:range skos:Concept ;
	rdfs:seeAlso
		"https://www.era.europa.eu/era-folder/radio-system-compatibility-rsc-voice-and-data-documents"^^xsd:anyURI ,
		"https://www.era.europa.eu/system/files/2022-11/list_harmonised_national_restriction_codes_en.pdf"^^xsd:anyURI ,
		"https://www.era.europa.eu/system/files/2023-05/esc-rsc_technical_document_en.pdf"^^xsd:anyURI
		;
	vs:term_status "stable" ;
	skos:note "Harmonised restriction code 2.4.20 (if Class A radio system is installed, so not `era-rscv-eratv:not-applicable` nor `era-rscv-rinf:10`)."@en ;
	skos:scopeNote """Information on RSC voice requirements per country is given in the referred document.

Vehicles are considered compatible with the infrastructure regarding this parameter, if any of the values declared matches. 
In case the value “Not Defined” or “RSC-EU-0” is used, repetitions with additional values are not expected."""@en ;
