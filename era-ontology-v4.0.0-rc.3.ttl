era:configDependentCompliance
	a owl:ObjectProperty ;
	rdfs:label "configuration dependent conformities/compliances"@en ;
	rdfs:comment "This property is used to link a vehicle type with its conformity checks, through the authorisation case(s)"@en ;
	era:shaclShapeValidationRule
		<http://data.europa.eu/949/evr/shapes/ConfigDependentCompliance> ,
		<http://data.europa.eu/949/shapes/ConfigDependentCompliance>
		;
	dcterms:created "2025-04-04"^^xsd:date ;
	rdfs:domain era:VehicleTypeAuthorisationCase ;
	rdfs:isDefinedBy <http://data.europa.eu/949/> ;
	rdfs:range era:Compliance ;
	skos:example """
```
eratv:vac-uuid(type) a era:VehicleTypeAuthorisationCase ;
  era:configDependentCompliance [
    a era:VehicleTypeAuthorisationCheck ;
    vpa:checkedSection <URI-to-TSI-Section checked> ; # always available
    vpa:checkedRequirement <URI-to-TSI> ; # always available
    vpa:withRestriction eratv:nccfu-uuid(type) ;
  ] .

eratv:nccfu-uuid(type) a era:VehicleTypeAuthorisationRestriction ;
  era:forConfiguration <URI-to-Configuration-1> , <URI-to-Configuration-2> ; # all configs sharing the same conformity result
  # if any conditions result from this check, they can be added here.
```
""" ;
	.

era:configDependentCondition
	a owl:ObjectProperty ;
	rdfs:label "configuration dependent conditions of use and other restrictions"@en ;
	rdfs:comment "This property is used to link a vehicle type with its restrictions, through the authorisation case(s)"@en ;
	era:shaclShapeValidationRule
		<http://data.europa.eu/949/evr/shapes/ConfigDependentCondition> ,
		<http://data.europa.eu/949/shapes/ConfigDependentCondition>
		;
	dcterms:created "2025-02-21"^^xsd:date ;
	dcterms:modified "2026-01-29"^^xsd:date ;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf (
			era:VehicleAuthorisationCase
			era:VehicleTypeAuthorisationCase
		) ;
	] ;
	rdfs:isDefinedBy <http://data.europa.eu/949/> ;
	rdfs:range era:Compliance ;
	skos:example '''
```
eratv:vac-uuid(type) a era:VehicleTypeAuthorisationCase ;
  era:configDependentCondition [
    a era:VehicleTypeAuthorisationCheck ;
    vpa:checkedSection <URI-to-TSI-Section checked> ; # if available
    vpa:checkedRequirement <URI-to-TSI> ; # if available
    vpa:withRestriction eratv:nccfu-uuid(type) ;
  ] .

eratv:nccfu-uuid(type) a era:VehicleTypeAuthorisationRestriction ;
  era:forConfiguration <URI-to-Configuration-1> , <URI-to-Configuration-2> ; # all configs sharing the same restrictions
  era:nonCodedRestrictions ""{{Text of the non-coded restrictions}}""@en ;
  era:minimumHorizontalRadius 150^^xsd:integer ;
  era:maximumDesignSpeed 200^^xsd:integer ;
  era:temperatureRange <URI-climatic zone> ;
  # other coded CfU.

```
''' ;
	.

