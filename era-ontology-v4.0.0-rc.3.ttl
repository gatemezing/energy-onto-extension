era:CombinationTag
	a owl:Class ;
	rdfs:label "Combination Tag"@en ;
	rdfs:comment """Tag to indicate that some products from a provider can be sold only when in conjunction
with product(s) from another provider using the same tag. At least one, not all,
combinationTags must be in common to allow combination. No combinationTags indicate
that there are no combination constraints on the product.
"""@en ;
	era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/NodeShape/CombinationTag> ;
	era:usedInTelematics "true"^^xsd:boolean ;
