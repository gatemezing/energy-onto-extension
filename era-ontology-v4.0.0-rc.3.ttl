era:stockControlNumbers
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf era:telematicsData_pg ;
	rdfs:label "Stock Control Numbers"@en ;
	rdfs:comment """The ids of the secure paper stock that identifies the blank secure paper stock used for printing.

The stock control number is only used for secure paper stock and triggers a printing of the stock control number in the ticket layout. This establishes a link between paper stock and ticket that is used to control the usage of blank secure paper stock at offices as secure paper has otherwise no intrinsic protection against internal fraud.
"""@en ;
	era:usedInTelematics "true"^^xsd:boolean ;
	dcterms:created "2026-10-02T13:09:07+00:00"^^xsd:dateTime ;
	dcterms:references "https://osdm.io/osdm/update/2026/03/25/OSDM-V3.8-released"^^xsd:anyURI ;
