	a owl:Class ;
	rdfs:label "Validity constraint"@en ;
	rdfs:comment "Abstract superclass for constraints on CLD validity periods, as prescribed by a TSI or Decision 2010/713/EU."@en ;
	dcterms:created "2026-02-12"^^xsd:date ;
	rdfs:isDefinedBy <http://data.europa.eu/949/> ;
	vs:term_status "stable" ;
	.

