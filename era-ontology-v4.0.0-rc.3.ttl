era:SubsidiaryLocation
	a owl:Class ;
	rdfs:subClassOf
		era:Feature ,
		[
			a owl:Restriction ;
			owl:onProperty era:linkedToPrimaryLocation ;
			owl:onClass era:PrimaryLocation ;
			owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		]
		;
	rdfs:label "Subsidiary location"@en ;
	rdfs:comment
		"Code, Name and allocation company of Subsidiary Location"@en ,
		"Subsidiary location must be linked to a Primary Location and specifies in more detailed way part, attributes, or usage of Primary location. It may be also a non-rail point or a rail point that is not managed by an Infrastructure Manager (IM). It may be defined by entity having company code according to their needs. The Subsidiary location is optional and dependent upon business needs."@en
		;
	era:shaclShapeValidationRule
		<http://data.europa.eu/949/shapes/NodeShape/LocationSubsidiaryIdentification> ,
		<http://data.europa.eu/949/shapes/SubsidiaryLocationShape>
		;
	era:usedInTelematics "true"^^xsd:boolean ;
	dcterms:created
		"2024-05-24"^^xsd:date ,
