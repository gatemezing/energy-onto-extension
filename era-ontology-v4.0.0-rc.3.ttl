era:profileNumberSemiTrailers
	a owl:ObjectProperty ;
	rdfs:subPropertyOf era:lineLayoutObjParameter ;
	rdfs:label "Standard combined transport profile number for semi-trailers"@en ;
	rdfs:comment "Coding for combined transport for semi-trailers (for all freight and mixed-traffic lines) in accordance with the specification referenced in Appendix A-1, index [B]."@en ;
	era:XMLName "ILL_ProfileNumSemiTrailers" ;
	era:applicable "Y/N" ;
	era:inSkosConceptScheme <http://data.europa.eu/949/concepts/profile-num-semi-trailers/ProfileNumbersSemiTrailers> ;
	era:legalDeadline "by 16 March 2019 at the latest for lines belonging to the TEN (1.1.1.1.2.1)"@en ;
	era:rinfIndex "1.1.1.1.3.5" ;
	era:shaclShapeValidationRule
		<http://data.europa.eu/949/shapes/InSkosConceptScheme> ,
		<http://data.europa.eu/949/shapes/ProfileNumberSemiTrailers>
		;
	era:usedInRCCCalculations "true"^^xsd:boolean ;
	dcterms:created "2021-08-03"^^xsd:date ;
	dcterms:modified "2023-03-14"^^xsd:date ;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf (
			era:CommonCharacteristicsSubset
			era:RunningTrack
		) ;
	] ;
	rdfs:isDefinedBy <http://data.europa.eu/949/> ;
	rdfs:range skos:Concept ;
	vs:term_status "stable" ;
	skos:scopeNote """The technical number is made up of the wagon compatibility code (1 letter) and the standard combined transport profile number (2 digits when width <= 2500 mm or 3 digits when 2500 < width <= 2600 mm).
Additional values than the already identified in the list above are possible. They will be introduced by the Agency on request via a process of change request."""@en ;
	.

