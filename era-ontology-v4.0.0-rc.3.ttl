		"2024-04-18"^^xsd:date ,
		"2024-06-03"^^xsd:date
		;
	rdfs:isDefinedBy <http://data.europa.eu/949/> ;
	owl:deprecated "true"^^xsd:boolean ;
	vs:term_status "stable" ;
	.

era:VehicleKeeperMarking
	a owl:Class ;
	rdfs:subClassOf era:OrganisationRole ;
	rdfs:label "Vehicle Keeper Marking"@en ;
	rdfs:comment "The class used to relate a Vehicle Keeper Marking (VKM) properties for the purpose of the VKM register."@en ;
	rdfs:isDefinedBy <http://data.europa.eu/949/> ;
	rdfs:seeAlso "https://eur-lex.europa.eu/legal-content/EN/ALL/?uri=OJ%3AL%3A2012%3A345%3ATOC"^^xsd:anyURI ;
	.

era:VehicleLoadingTrainType
	a owl:Class ;
	rdfs:label "Type of vehicle loading train"@en ;
	rdfs:comment "All data concerning the train for car carriage including the information to load and unload a car."@en ;
	era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/NodeShape/VehicleLoadingTrainType> ;
	era:usedInTelematics "true"^^xsd:boolean ;
	dcterms:created "2026-10-02T13:08:22+00:00"^^xsd:dateTime ;
