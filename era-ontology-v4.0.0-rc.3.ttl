era:Zone
	a owl:Class ;
	rdfs:label "Zone"@en ;
	rdfs:comment """carrier - carrier responsible for the transport.
entryStation - Station to enter the zone in case the product requires to enter the zone via a specific station
(e.g. local zone ticket to start from the main rail station).
terminalStation - Terminal station in case the product requires a destination within the zone (e.g. local ticket
to go to the main rail station).
"""@en ;
	era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/NodeShape/Zone> ;
	era:usedInTelematics "true"^^xsd:boolean ;
	dcterms:created "2026-10-02T13:09:07+00:00"^^xsd:dateTime ;
	dcterms:references "https://osdm.io/osdm/update/2026/03/25/OSDM-V3.8-released"^^xsd:anyURI ;
	.

