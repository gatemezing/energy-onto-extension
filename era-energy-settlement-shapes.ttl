@prefix ens:   <http://data.europa.eu/dy6/def/energy/> .
@prefix era:   <http://data.europa.eu/949/> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix ensc:  <http://data.europa.eu/dy6/def/energy/concepts/> .
@prefix eraor: <http://data.europa.eu/949/concepts/organisation-roles/> .
@prefix enssh: <http://data.europa.eu/dy6/def/energy/shapes/> .

enssh:ConsumptionPointShape a sh:NodeShape ;
    sh:targetClass ens:ConsumptionPoint ;
    sh:property [
        sh:path ens:consumptionPointId ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path ens:consumptionPointOf ;
        sh:class era:Vehicle ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:sparql [
        sh:message "Consumption-point ID must normalize to the linked vehicle's 12-digit EVN." ;
        sh:select """
            PREFIX ens: <http://data.europa.eu/dy6/def/energy/>
            PREFIX era: <http://data.europa.eu/949/>
            SELECT $this
            WHERE {
                $this ens:consumptionPointId ?id ;
                      ens:consumptionPointOf/era:vehicleNumber ?evn .
                BIND(REPLACE(STR(?id), "[ -]", "") AS ?normalizedId)
                BIND(REPLACE(STR(?evn), "[ -]", "") AS ?normalizedEvn)
                FILTER(!REGEX(?normalizedId, "^[0-9]{12}$") ||
                       !REGEX(?normalizedEvn, "^[0-9]{12}$") ||
                       ?normalizedId != ?normalizedEvn)
            }
        """ ;
    ] .

enssh:TractionUnitVehicleShape a sh:NodeShape ;
    sh:targetClass era:TrainCompositionJourneySection ;
    sh:sparql [
        sh:message "A locomotive EVN must normalize to exactly one registered vehicle." ;
        sh:select """
            PREFIX ens: <http://data.europa.eu/dy6/def/energy/>
            PREFIX era: <http://data.europa.eu/949/>
            SELECT $this
            WHERE {
                $this era:locoNumber ?loco .
                BIND(REPLACE(STR(?loco), "[ -]", "") AS ?normalizedLoco)
                FILTER(!REGEX(?normalizedLoco, "^[0-9]{12}$"))
            }
        """ ;
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        sh:construct """
            PREFIX ens: <http://data.europa.eu/dy6/def/energy/>
            PREFIX era: <http://data.europa.eu/949/>
            CONSTRUCT { $this ens:tractionUnitVehicle ?vehicle }
            WHERE {
                $this era:locoNumber ?loco .
                ?vehicle era:vehicleNumber ?evn .
                BIND(REPLACE(STR(?loco), "[ -]", "") AS ?normalizedLoco)
                BIND(REPLACE(STR(?evn), "[ -]", "") AS ?normalizedEvn)
                FILTER(REGEX(?normalizedLoco, "^[0-9]{12}$") &&
                       ?normalizedLoco = ?normalizedEvn)
            }
        """ ;
    ] .

enssh:EnergyReadingShape a sh:NodeShape ;
    sh:targetSubjectsOf ens:readingPeriod ;
    sh:property [
        sh:path ens:readingOfConsumptionPoint ;
        sh:class ens:ConsumptionPoint ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path ens:readingPeriod ;
        sh:class <http://www.w3.org/2006/time#Interval> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path ens:activeEnergyConsumed ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:minInclusive 0 ;
    ] ;
    sh:property [
        sh:path ens:activeEnergyRegenerated ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:minInclusive 0 ;
    ] ;
    sh:property [
        sh:path ens:measurementQuality ;
        sh:class skos:Concept ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:sparql [
        sh:message "Reading period must have a beginning strictly before its end." ;
        sh:select """
            PREFIX ens: <http://data.europa.eu/dy6/def/energy/>
            PREFIX time: <http://www.w3.org/2006/time#>
            SELECT $this
            WHERE {
                $this ens:readingPeriod ?interval .
                ?interval time:hasBeginning/time:inXSDDateTimeStamp ?start ;
                          time:hasEnd/time:inXSDDateTimeStamp ?end .
                FILTER(?start >= ?end)
            }
        """ ;
    ] .

enssh:EnergyAllocationShape a sh:NodeShape ;
    sh:targetClass ens:EnergyAllocation ;
    sh:property [
        sh:path ens:hasAllocationComponent ;
        sh:class ens:AllocationComponent ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path ens:allocatedTo ;
        sh:class ens:EnergyConsumerRole ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path ens:allocatedInZone ;
        sh:class ens:SettlementZone ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path ens:allocationStatus ;
        sh:class skos:Concept ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path ens:allocatedActiveEnergyConsumed ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:minInclusive 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path ens:allocatedActiveEnergyRegenerated ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:minInclusive 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path ens:allocatedNetActiveEnergy ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path ens:allocationMethod ;
        sh:class skos:Concept ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path ens:allocationRule ;
        sh:class prov:Entity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path ens:allocationVersion ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:sparql [
        sh:message "Net active energy must equal allocated consumption minus allocated regeneration." ;
        sh:select """
            PREFIX ens: <http://data.europa.eu/dy6/def/energy/>
            SELECT $this
            WHERE {
                $this ens:allocatedActiveEnergyConsumed ?consumed ;
                      ens:allocatedActiveEnergyRegenerated ?regenerated ;
                      ens:allocatedNetActiveEnergy ?net .
                FILTER(ABS(?net - (?consumed - ?regenerated)) > 0.000001)
            }
        """ ;
    ] ;
    sh:sparql [
        sh:message "A metered allocation must cite source readings, run, composition, and running information." ;
        sh:select """
            PREFIX ens: <http://data.europa.eu/dy6/def/energy/>
            PREFIX ensc: <http://data.europa.eu/dy6/def/energy/concepts/>
            SELECT $this
            WHERE {
                {
                    $this ens:allocationStatus ensc:meteredValid .
                    FILTER NOT EXISTS { $this ens:allocatesReading ?reading }
                }
                UNION
                {
                    $this ens:allocationStatus ensc:meteredValid .
                    FILTER NOT EXISTS { $this ens:matchedRunningTrain ?run }
                }
                UNION
                {
                    $this ens:allocationStatus ensc:meteredValid .
                    FILTER NOT EXISTS { $this ens:matchedComposition ?message }
                }
                UNION
                {
                    $this ens:allocationStatus ensc:meteredValid .
                    FILTER NOT EXISTS { $this ens:matchedRunningInformation ?message }
                }
            }
        """ ;
    ] ;
    sh:sparql [
        sh:message "Allocation component source readings must exactly match the allocation's cited readings." ;
        sh:select """
            PREFIX ens: <http://data.europa.eu/dy6/def/energy/>
            PREFIX ensc: <http://data.europa.eu/dy6/def/energy/concepts/>
            SELECT $this
            WHERE {
                {
                    $this ens:allocationStatus ensc:meteredValid ;
                          ens:allocatesReading ?reading .
                    FILTER NOT EXISTS {
                        $this ens:hasAllocationComponent/ens:componentReading ?reading
                    }
                }
                UNION
                {
                    $this ens:allocationStatus ensc:meteredValid ;
                          ens:hasAllocationComponent/ens:componentReading ?reading .
                    FILTER NOT EXISTS { $this ens:allocatesReading ?reading }
                }
            }
        """ ;
    ] ;
    sh:sparql [
        sh:message "The allocation consumer must match the consumer assigned to its running train." ;
        sh:select """
            PREFIX ens: <http://data.europa.eu/dy6/def/energy/>
            SELECT $this
            WHERE {
                $this ens:matchedRunningTrain ?run ;
                      ens:allocatedTo ?consumer .
                FILTER NOT EXISTS { ?run ens:consumerRole ?consumer }
            }
        """ ;
    ] .

enssh:AllocationComponentShape a sh:NodeShape ;
    sh:targetClass ens:AllocationComponent ;
    sh:property [
        sh:path ens:componentActiveEnergyConsumed ;
        sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:minInclusive 0 ;
    ] ;
    sh:property [
        sh:path ens:componentActiveEnergyRegenerated ;
        sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:minInclusive 0 ;
    ] ;
    sh:property [
        sh:path ens:componentNetActiveEnergy ;
        sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:sparql [
        sh:message "Component net active energy must equal consumed minus regenerated." ;
        sh:select """
            PREFIX ens: <http://data.europa.eu/dy6/def/energy/>
            SELECT $this
            WHERE {
                $this ens:componentActiveEnergyConsumed ?consumed ;
                      ens:componentActiveEnergyRegenerated ?regenerated ;
                      ens:componentNetActiveEnergy ?net .
                FILTER(ABS(?net - (?consumed - ?regenerated)) > 0.000001)
            }
        """ ;
    ] ;
    sh:sparql [
        sh:message "The sum of components attributed to a source reading must not exceed its measured consumed energy." ;
        sh:select """
            PREFIX ens: <http://data.europa.eu/dy6/def/energy/>
            SELECT $this
            WHERE {
                $this ens:componentReading ?reading .
                ?reading ens:activeEnergyConsumed ?source .
                $this ens:componentActiveEnergyConsumed ?allocated .
                FILTER(?allocated > ?source)
            }
        """ ;
    ] .

enssh:RunningTrainShape a sh:NodeShape ;
    sh:targetClass ens:RunningTrain ;
    sh:property [
        sh:path era:trainDepartureDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path era:trainOperatingRU ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path ens:operatingRailwayUndertaking ;
        sh:class era:OrganisationRole ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node enssh:RailwayUndertakingRoleShape ;
    ] ;
    sh:property [
        sh:path era:operationalTrainNumber ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path ens:runStart ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path ens:runEnd ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path ens:consumerRole ;
        sh:class ens:EnergyConsumerRole ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path ens:actualDepartureEvidence ;
        sh:class prov:Entity ;
        sh:maxCount 1 ;
    ] ;
    sh:sparql [
        sh:message "Operational train number and departure date must identify one running train." ;
        sh:select """
            PREFIX era: <http://data.europa.eu/949/>
            SELECT $this
            WHERE {
                $this era:operationalTrainNumber ?number ; era:trainDepartureDate ?date .
                ?other era:operationalTrainNumber ?number ; era:trainDepartureDate ?date .
                FILTER(?other != $this)
            }
        """ ;
    ] ;
    sh:sparql [
        sh:message "The operating RU role must belong to the body whose ERA organisation code is the source era:trainOperatingRU code." ;
        sh:select """
            PREFIX ens: <http://data.europa.eu/dy6/def/energy/>
            PREFIX era: <http://data.europa.eu/949/>
            SELECT $this
            WHERE {
                $this era:trainOperatingRU ?sourceCode ;
                      ens:operatingRailwayUndertaking/era:roleOf ?body .
                FILTER NOT EXISTS { ?body era:organisationCode ?sourceCode }
            }
        """ ;
    ] ;
    sh:sparql [
        sh:message "Running-train start must precede its end, and actual departure must fall within the run interval." ;
        sh:select """
            PREFIX ens: <http://data.europa.eu/dy6/def/energy/>
            SELECT $this
            WHERE {
                {
                    $this ens:runStart ?start ; ens:runEnd ?end .
                    FILTER(?start >= ?end)
                }
                UNION
                {
                    $this ens:runStart ?start ; ens:runEnd ?end ;
                          ens:actualDepartureTime ?departure .
                    FILTER(?departure < ?start || ?departure > ?end)
                }
            }
        """ ;
    ] ;
    sh:sparql [
        sh:message "Actual departure time and its evidence reference must be supplied together." ;
        sh:select """
            PREFIX ens: <http://data.europa.eu/dy6/def/energy/>
            SELECT $this
            WHERE {
                {
                    $this ens:actualDepartureTime ?time .
                    FILTER NOT EXISTS { $this ens:actualDepartureEvidence ?evidence }
                }
                UNION
                {
                    $this ens:actualDepartureEvidence ?evidence .
                    FILTER NOT EXISTS { $this ens:actualDepartureTime ?time }
                }
            }
        """ ;
    ] .

enssh:TrainMessageShape a sh:NodeShape ;
    sh:targetClass era:TrainCompositionMessage, era:TrainRunningInformationMessage ;
    sh:property [
        sh:path ens:aboutRunningTrain ;
        sh:class ens:RunningTrain ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:sparql [
        sh:message "The linked run's operational train number must match the message number." ;
        sh:select """
            PREFIX ens: <http://data.europa.eu/dy6/def/energy/>
            PREFIX era: <http://data.europa.eu/949/>
            SELECT $this
            WHERE {
                $this era:operationalTrainNumberIdentifier/era:operationalTrainNumber ?messageNumber ;
                      ens:aboutRunningTrain/era:operationalTrainNumber ?runNumber .
                FILTER(?messageNumber != ?runNumber)
            }
        """ ;
    ] ;
    sh:sparql [
        sh:message "A composition message created after actual departure needs a timeliness assessment and supporting evidence." ;
        sh:select """
            PREFIX ens: <http://data.europa.eu/dy6/def/energy/>
            PREFIX era: <http://data.europa.eu/949/>
            SELECT $this
            WHERE {
                $this a era:TrainCompositionMessage ;
                      era:messageHeader/era:messageDateTimeCreated ?created ;
                      ens:aboutRunningTrain/ens:actualDepartureTime ?departure .
                FILTER(?created > ?departure)
                FILTER NOT EXISTS {
                    $this ens:timelinessAssessment ?assessment ;
                          ens:timelinessEvidence ?evidence ;
                          ens:timelinessAuthority ?authority
                }
            }
        """ ;
    ] ;
    sh:sparql [
        sh:message "Running-report timestamps must fall within the linked running train's validity interval." ;
        sh:select """
            PREFIX ens: <http://data.europa.eu/dy6/def/energy/>
            PREFIX era: <http://data.europa.eu/949/>
            SELECT $this
            WHERE {
                $this a era:TrainRunningInformationMessage ;
                      ens:aboutRunningTrain/ens:runStart ?start ;
                      ens:aboutRunningTrain/ens:runEnd ?end ;
                      era:trainLocationReport/era:locationDateTime ?reported .
                FILTER(?reported < ?start || ?reported > ?end)
            }
        """ ;
    ] .

enssh:RunningMessageShape a sh:NodeShape ;
    sh:targetClass era:TrainRunningInformationMessage ;
    sh:property [
        sh:path ens:responsibleRUOrganisation ;
        sh:class era:Body ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:sparql [
        sh:message "The resolved RU organization must match the source responsibleRU company code." ;
        sh:select """
            PREFIX ens: <http://data.europa.eu/dy6/def/energy/>
            PREFIX era: <http://data.europa.eu/949/>
            SELECT $this
            WHERE {
                $this era:responsibleRU ?sourceCode ;
                      ens:responsibleRUOrganisation ?organization .
                FILTER NOT EXISTS { ?organization era:organisationCode ?sourceCode }
            }
        """ ;
    ] .

enssh:DataExchangeActivityShape a sh:NodeShape ;
    sh:targetClass ens:DataExchangeActivity ;
    sh:property [
        sh:path ens:exchangedMessage ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path ens:exchangeSender ;
        sh:class era:Body ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path ens:exchangeRecipient ;
        sh:class ens:SettlementSystem ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path ens:exchangeTime ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path ens:messageVersion ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minLength 1 ;
    ] ;
    sh:property [
        sh:path ens:exchangeOutcome ;
        sh:class skos:Concept ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path ens:exchangePurpose ;
        sh:class skos:Concept ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path ens:exchangeAuthority ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path ens:retentionPolicy ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:sparql [
        sh:message "The exchange recipient's receipt record must point back to this exchange activity." ;
        sh:select """
            PREFIX ens: <http://data.europa.eu/dy6/def/energy/>
            SELECT $this
            WHERE {
                $this ens:exchangeRecipient ?recipient .
                FILTER NOT EXISTS { ?recipient ens:exchangeContains $this }
            }
        """ ;
    ] .

enssh:EnergyMeasurementSystemShape a sh:NodeShape ;
    sh:targetClass ens:EnergyMeasurementSystem ;
    sh:property [
        sh:path ens:installedOn ;
        sh:class era:Vehicle ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path ens:measuresConsumptionPoint ;
        sh:class ens:ConsumptionPoint ;
        sh:minCount 1 ;
    ] .

enssh:ForwardsToShape a sh:NodeShape ;
    sh:targetSubjectsOf ens:forwardsTo ;
    sh:sparql [
        sh:message "ens:forwardsTo must link a DCS to an exchange function, or an exchange function to a settlement system." ;
        sh:select """
            PREFIX ens: <http://data.europa.eu/dy6/def/energy/>
            SELECT $this ?value WHERE {
                $this ens:forwardsTo ?value .
                FILTER NOT EXISTS {
                    { $this a ens:DataCollectingSystem . ?value a ens:ExchangeFunction . }
                    UNION
                    { $this a ens:ExchangeFunction . ?value a ens:SettlementSystem . }
                }
            }
        """ ;
    ] .

enssh:RailwayUndertakingRoleShape a sh:NodeShape ;
    sh:property [
        sh:path era:roleOf ;
        sh:class era:Body ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path era:hasOrganisationRole ;
        sh:in ( eraor:RU eraor:RU-1 eraor:RU-2 eraor:RU-3 eraor:RU-4 eraor:RU-5 eraor:RU-6 eraor:RU-7 ) ;
        sh:minCount 1 ;
        sh:message "The operating railway undertaking must be an organisation role typed with the ERA RU concept or one of its narrower RU-n concepts." ;
    ] .
