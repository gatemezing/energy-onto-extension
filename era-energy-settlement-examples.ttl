# SPDX-License-Identifier: EUPL-1.2
@prefix ens:    <http://data.europa.eu/dy6/def/energy/> .
@prefix ensc:   <http://data.europa.eu/dy6/def/energy/concepts/> .
@prefix era:   <http://data.europa.eu/949/> .
@prefix eraor: <http://data.europa.eu/949/concepts/organisation-roles/> .
@prefix d:     <http://example.org/data/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix time:  <http://www.w3.org/2006/time#> .
@prefix geo:   <http://www.opengis.net/ont/geosparql#> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix sosa:  <http://www.w3.org/ns/sosa/> .
@prefix qudt:  <http://qudt.org/schema/qudt/> .
@prefix unit:  <http://qudt.org/vocab/unit/> .
@prefix country: <http://publications.europa.eu/resource/authority/country/> .

# =====================================================================
# Example data for validating the energy settlement extension (v0.8)
# against the competency questions in era-energy-settlement-cqs.md.
#
# Scenario: freight train 41234, operated by a fictitious RU, runs from
# Norway to Sweden over the Magnor–Charlottenberg border on 2026-10-15.
# A second locomotive exercises the warning and estimation paths.
# Organisation names are real; EVNs, train numbers, energy values,
# border point ID and the energy supply concept are illustrative.
# Country concepts are the EU authority table used by era:inCountry.
# Must conform to era-energy-settlement-shapes.ttl (warnings expected
# only for d:ems2 and d:tcm2).
# =====================================================================

# --- Proposed SKOS concept schemes (part of the proposal) ------------

ensc:EmsStandardVersions a skos:ConceptScheme ; skos:prefLabel "EMS standard versions"@en .
ensc:EN50463-2012 a skos:Concept ; skos:inScheme ensc:EmsStandardVersions ; skos:prefLabel "EN 50463:2012"@en .
ensc:EN50463-2017 a skos:Concept ; skos:inScheme ensc:EmsStandardVersions ; skos:prefLabel "EN 50463:2017"@en .

ensc:ExchangeProtocols a skos:ConceptScheme ; skos:prefLabel "Energy data exchange protocols"@en .
ensc:IRS90930 a skos:Concept ; skos:inScheme ensc:ExchangeProtocols ; skos:prefLabel "UIC IRS 90930"@en .
ensc:UTILTS a skos:Concept ; skos:inScheme ensc:ExchangeProtocols ; skos:prefLabel "UTILTS (legacy)"@en .

ensc:AllocationStatuses a skos:ConceptScheme ; skos:prefLabel "Allocation statuses"@en .
ensc:meteredValid a skos:Concept ; skos:inScheme ensc:AllocationStatuses ; skos:prefLabel "metered, valid"@en .
ensc:estimated a skos:Concept ; skos:inScheme ensc:AllocationStatuses ; skos:prefLabel "estimated"@en .

ensc:MeasurementQuality a skos:ConceptScheme ; skos:prefLabel "Measurement quality"@en .
ensc:qualityAccepted a skos:Concept ; skos:inScheme ensc:MeasurementQuality ; skos:prefLabel "accepted for settlement (illustrative)"@en .

ensc:AllocationMethods a skos:ConceptScheme ; skos:prefLabel "Allocation methods"@en .
ensc:meteredByConsumptionPoint a skos:Concept ; skos:inScheme ensc:AllocationMethods ; skos:prefLabel "metered by consumption point"@en .
ensc:estimatedFromOperationalData a skos:Concept ; skos:inScheme ensc:AllocationMethods ; skos:prefLabel "estimated from operational data (illustrative)"@en .

ensc:ExchangeOutcomes a skos:ConceptScheme ; skos:prefLabel "Exchange outcomes"@en .
ensc:received a skos:Concept ; skos:inScheme ensc:ExchangeOutcomes ; skos:prefLabel "received (illustrative)"@en .

ensc:ExchangePurposes a skos:ConceptScheme ; skos:prefLabel "Exchange purposes"@en .
ensc:energySettlement a skos:Concept ; skos:inScheme ensc:ExchangePurposes ; skos:prefLabel "energy settlement (illustrative)"@en .

ensc:TimelinessAssessments a skos:ConceptScheme ; skos:prefLabel "Composition message timeliness assessments"@en .
ensc:exceptionEvidenceRecorded a skos:Concept ; skos:inScheme ensc:TimelinessAssessments ; skos:prefLabel "exception evidence recorded (illustrative only)"@en .

d:ess15kV a skos:Concept ; skos:prefLabel "AC 15 kV 16.7 Hz (illustrative concept)"@en .

# --- Organisations and roles -----------------------------------------

d:baneNor a era:Body ; rdfs:label "Bane NOR" .
d:trafikverket a era:Body ; rdfs:label "Trafikverket" .
d:eress a era:Body ; rdfs:label "Eress" .
d:nordCargo a era:Body ; rdfs:label "Nord Cargo AS (fictitious RU)" .
d:railLease a era:Body ; rdfs:label "RailLease AB (fictitious lessor)" .
d:nordCargo era:organisationCode "3801" .

# These placeholders document where deployment-specific approvals must be
# linked. They are not legal opinions, contracts, or actual retention rules.
d:authorityToVerify a prov:Entity ; rdfs:label "Applicable legal or contractual authority (verify before deployment)"@en .
d:retentionToApprove a prov:Entity ; rdfs:label "Approved retention schedule (configure before deployment)"@en .
d:allocationRuleV1 a prov:Entity ; rdfs:label "Illustrative allocation rule, version 1"@en .
d:departureEvent a prov:Entity ; rdfs:label "Illustrative authoritative departure event"@en .
d:departureEvent2 a prov:Entity ; rdfs:label "Illustrative authoritative departure event for run 2"@en .
d:lateMessageEvidence a prov:Entity ; rdfs:label "Illustrative operational evidence for late composition message"@en .

d:ruRole a ens:EnergyConsumerRole ; era:roleOf d:nordCargo .
d:nordCargoRU a era:OrganisationRole ; era:roleOf d:nordCargo ; era:hasOrganisationRole eraor:RU-3 .
d:keeperRole a era:OrganisationRole ; era:roleOf d:railLease .
d:emsRespRole a ens:EMSResponsibleRole ; era:roleOf d:railLease .
d:dcsAdminRole a ens:DCSAdministratorRole ; era:roleOf d:eress .
d:settleOpNO a ens:SettlementOperatorRole ; era:roleOf d:baneNor .
d:settleOpSE a ens:SettlementOperatorRole ; era:roleOf d:trafikverket .
d:imNO a era:OrganisationRole ; era:roleOf d:baneNor ; era:hasOrganisationRole eraor:IM .
d:imSE a era:OrganisationRole ; era:roleOf d:trafikverket ; era:hasOrganisationRole eraor:IM .

# --- Vehicles and vehicle types --------------------------------------

d:typeA a era:VehicleType ; era:configDependentParameter d:typeAParams .
d:typeAParams a era:VehicleTypeConfigParameterSet ; era:hasOnboardEnergyMeasurement true .
d:typeB a era:VehicleType .                       # declares no energy meter

d:loco1 a era:Vehicle ;
    era:vehicleNumber "918061890013" ;
    era:vehicleType d:typeA ;
    era:vehicleKeeper d:keeperRole .

d:loco2 a era:Vehicle ;
    era:vehicleNumber "917421940025" ;
    era:vehicleType d:typeB ;
    era:vehicleKeeper d:keeperRole .

# --- On-board measurement --------------------------------------------

d:ems1 a ens:EnergyMeasurementSystem ;
    sosa:isHostedBy d:loco1 ;
    sosa:hosts d:emf1 , d:dhs1 ;
    ens:measuresConsumptionPoint d:cp1 ;
    ens:emsStandardVersion ensc:EN50463-2017 ;
    ens:emsResponsible d:emsRespRole .
d:emf1 a ens:EnergyMeasurementFunction ;
    sosa:observes ens:ConsumedActiveEnergy , ens:RegeneratedActiveEnergy , ens:MeasuredReactiveEnergy .
d:dhs1 a ens:DataHandlingSystem .

d:ems2 a ens:EnergyMeasurementSystem ;             # R4 warning: typeB has no meter
    sosa:isHostedBy d:loco2 ;
    sosa:hosts d:emf2 ;
    ens:measuresConsumptionPoint d:cp2 ;
    ens:emsStandardVersion ensc:EN50463-2012 ;
    ens:emsResponsible d:emsRespRole .
d:emf2 a ens:EnergyMeasurementFunction ;
    sosa:observes ens:ConsumedActiveEnergy , ens:RegeneratedActiveEnergy , ens:MeasuredReactiveEnergy .

d:cp1 a ens:ConsumptionPoint ; ens:consumptionPointId "918061890013" ; ens:consumptionPointOf d:loco1 .
d:cp2 a ens:ConsumptionPoint ; ens:consumptionPointId "917421940025" ; ens:consumptionPointOf d:loco2 .

# --- CEBD and readings -----------------------------------------------

d:cebd1 a ens:CompiledEnergyBillingData ;
    ens:compiledBy d:ems1 ;
    sosa:hasMember d:r1 , d:r2 , d:r3 .

d:cebd2 a ens:CompiledEnergyBillingData ;
    ens:compiledBy d:ems2 ;
    sosa:hasMember d:r4 .

d:r1 a ens:EnergyReading ;
    sosa:hasFeatureOfInterest d:cp1 ;
    ens:measurementQuality ensc:qualityAccepted ;
    sosa:phenomenonTime [ a time:Interval ;
        time:hasBeginning [ time:inXSDDateTimeStamp "2026-10-15T06:00:00Z"^^xsd:dateTimeStamp ] ;
        time:hasEnd       [ time:inXSDDateTimeStamp "2026-10-15T06:05:00Z"^^xsd:dateTimeStamp ] ] ;
    sosa:hasMember d:r1-consumed , d:r1-regenerated , d:r1-reactive ;
    geo:hasGeometry [ geo:asWKT "POINT(12.003 60.190)"^^geo:wktLiteral ] ;
    ens:readingOnTrack d:trackNO .

d:r1-consumed a sosa:Observation ;
    sosa:madeBySensor d:emf1 ;
    sosa:observedProperty ens:ConsumedActiveEnergy ;
    sosa:hasResult [ a qudt:QuantityValue ; qudt:numericValue 410.5 ; qudt:unit unit:KiloW-HR ] .
d:r1-regenerated a sosa:Observation ;
    sosa:madeBySensor d:emf1 ;
    sosa:observedProperty ens:RegeneratedActiveEnergy ;
    sosa:hasResult [ a qudt:QuantityValue ; qudt:numericValue 12.0 ; qudt:unit unit:KiloW-HR ] .
d:r1-reactive a sosa:Observation ;
    sosa:madeBySensor d:emf1 ;
    sosa:observedProperty ens:MeasuredReactiveEnergy ;
    sosa:hasResult [ a qudt:QuantityValue ; qudt:numericValue 30.2 ; qudt:unit unit:KiloVAR-HR ] .

d:r2 a ens:EnergyReading ;
    sosa:hasFeatureOfInterest d:cp1 ;
    ens:measurementQuality ensc:qualityAccepted ;
    sosa:phenomenonTime [ a time:Interval ;
        time:hasBeginning [ time:inXSDDateTimeStamp "2026-10-15T06:05:00Z"^^xsd:dateTimeStamp ] ;
        time:hasEnd       [ time:inXSDDateTimeStamp "2026-10-15T06:10:00Z"^^xsd:dateTimeStamp ] ] ;
    sosa:hasMember d:r2-consumed , d:r2-regenerated , d:r2-reactive ;
    geo:hasGeometry [ geo:asWKT "POINT(12.010 60.150)"^^geo:wktLiteral ] ;
    ens:readingOnTrack d:trackNO .

d:r2-consumed a sosa:Observation ;
    sosa:madeBySensor d:emf1 ;
    sosa:observedProperty ens:ConsumedActiveEnergy ;
    sosa:hasResult [ a qudt:QuantityValue ; qudt:numericValue 380.0 ; qudt:unit unit:KiloW-HR ] .
d:r2-regenerated a sosa:Observation ;
    sosa:madeBySensor d:emf1 ;
    sosa:observedProperty ens:RegeneratedActiveEnergy ;
    sosa:hasResult [ a qudt:QuantityValue ; qudt:numericValue 8.5 ; qudt:unit unit:KiloW-HR ] .
d:r2-reactive a sosa:Observation ;
    sosa:madeBySensor d:emf1 ;
    sosa:observedProperty ens:MeasuredReactiveEnergy ;
    sosa:hasResult [ a qudt:QuantityValue ; qudt:numericValue 28.0 ; qudt:unit unit:KiloVAR-HR ] .

d:r3 a ens:ReadingBlock ;                          # one-minute block, in Sweden
    sosa:hasFeatureOfInterest d:cp1 ;
    ens:measurementQuality ensc:qualityAccepted ;
    sosa:phenomenonTime [ a time:Interval ;
        time:hasBeginning [ time:inXSDDateTimeStamp "2026-10-15T08:40:00Z"^^xsd:dateTimeStamp ] ;
        time:hasEnd       [ time:inXSDDateTimeStamp "2026-10-15T08:41:00Z"^^xsd:dateTimeStamp ] ] ;
    sosa:hasMember d:r3-consumed , d:r3-regenerated , d:r3-reactive ;
    geo:hasGeometry [ geo:asWKT "POINT(12.290 59.880)"^^geo:wktLiteral ] ;
    ens:readingOnTrack d:trackSE .

d:r3-consumed a sosa:Observation ;
    sosa:madeBySensor d:emf1 ;
    sosa:observedProperty ens:ConsumedActiveEnergy ;
    sosa:hasResult [ a qudt:QuantityValue ; qudt:numericValue 95.2 ; qudt:unit unit:KiloW-HR ] .
d:r3-regenerated a sosa:Observation ;
    sosa:madeBySensor d:emf1 ;
    sosa:observedProperty ens:RegeneratedActiveEnergy ;
    sosa:hasResult [ a qudt:QuantityValue ; qudt:numericValue 3.1 ; qudt:unit unit:KiloW-HR ] .
d:r3-reactive a sosa:Observation ;
    sosa:madeBySensor d:emf1 ;
    sosa:observedProperty ens:MeasuredReactiveEnergy ;
    sosa:hasResult [ a qudt:QuantityValue ; qudt:numericValue 6.4 ; qudt:unit unit:KiloVAR-HR ] .

d:r4 a ens:EnergyReading ;                         # never allocated
    sosa:hasFeatureOfInterest d:cp2 ;
    ens:measurementQuality ensc:qualityAccepted ;
    sosa:phenomenonTime [ a time:Interval ;
        time:hasBeginning [ time:inXSDDateTimeStamp "2026-10-15T07:00:00Z"^^xsd:dateTimeStamp ] ;
        time:hasEnd       [ time:inXSDDateTimeStamp "2026-10-15T07:05:00Z"^^xsd:dateTimeStamp ] ] ;
    sosa:hasMember d:r4-consumed , d:r4-regenerated ;
    geo:hasGeometry [ geo:asWKT "POINT(11.950 60.200)"^^geo:wktLiteral ] ;
    ens:readingOnTrack d:trackNO .

d:r4-consumed a sosa:Observation ;
    sosa:madeBySensor d:emf2 ;
    sosa:observedProperty ens:ConsumedActiveEnergy ;
    sosa:hasResult [ a qudt:QuantityValue ; qudt:numericValue 250.0 ; qudt:unit unit:KiloW-HR ] .
d:r4-regenerated a sosa:Observation ;
    sosa:madeBySensor d:emf2 ;
    sosa:observedProperty ens:RegeneratedActiveEnergy ;
    sosa:hasResult [ a qudt:QuantityValue ; qudt:numericValue 0.0 ; qudt:unit unit:KiloW-HR ] .

# --- Infrastructure (RINF terms) -------------------------------------

d:trackNO a era:RunningTrack ; era:inCountry country:NOR ; era:contactLineSystem d:clsNO .
d:trackSE a era:RunningTrack ; era:inCountry country:SWE ; era:contactLineSystem d:clsSE .
d:clsNO a era:ContactLineSystem ; era:energySupplySystem d:ess15kV ; era:maxTrainCurrent 900 .
d:clsSE a era:ContactLineSystem ; era:energySupplySystem d:ess15kV ; era:maxTrainCurrent 1000 .

d:rbpMagnor a era:ReferenceBorderPoint ; era:borderPointId "NO-SE-MAG" .
d:opMagnor a era:OperationalPoint ;
    rdfs:label "Magnor" ;
    era:inCountry country:NOR ;
    era:primaryLocation d:plMagnor ;
    era:referenceBorderPoint d:rbpMagnor .
d:plMagnor a era:PrimaryLocation ; era:primaryLocationName "Magnor"@no .
d:plKongsvinger a era:PrimaryLocation ; era:primaryLocationName "Kongsvinger"@no .
d:plCharlottenberg a era:PrimaryLocation ; era:primaryLocationName "Charlottenberg"@sv .
d:plOslo a era:PrimaryLocation ; era:primaryLocationName "Alnabru"@no .

# --- Ground systems --------------------------------------------------

d:eressDCS a ens:DataCollectingSystem ;
    ens:receivesFrom d:ems1 , d:ems2 ;
    ens:forwardsTo d:erex ;
    ens:operatedBy d:dcsAdminRole .

d:erex a ens:ExchangeFunction ;
    rdfs:label "Erex" ;
    ens:forwardsTo d:settleNO , d:settleSE ;
    ens:exchangesWith d:foreignExchange ;
    ens:exchangeProtocol ensc:IRS90930 .

d:foreignExchange a ens:ExchangeFunction ;
    rdfs:label "Neighbouring exchange function (illustrative)" ;
    ens:exchangeProtocol ensc:IRS90930 .

d:legacyExchange a ens:ExchangeFunction ;
    rdfs:label "Legacy exchange (illustrative)" ;
    ens:exchangeProtocol ensc:UTILTS .

d:settleNO a ens:SettlementSystem ; ens:servesZone d:zoneNO ; ens:operatedBy d:settleOpNO .
d:settleSE a ens:SettlementSystem ; ens:servesZone d:zoneSE ; ens:operatedBy d:settleOpSE .
d:settleNO ens:exchangeContains d:exchangeTcm1NO, d:exchangeTri1NO, d:exchangeTri2NO, d:exchangeTcm2NO .
d:settleSE ens:exchangeContains d:exchangeTcm1SE, d:exchangeTri3SE .

d:zoneNO a ens:SettlementZone ; ens:zoneCountry country:NOR ; ens:delimitedBy d:rbpMagnor .
d:zoneSE a ens:SettlementZone ; ens:zoneCountry country:SWE ; ens:delimitedBy d:rbpMagnor .

# --- TEL TSI messages (rc.3 telematics terms) ------------------------

d:tcm1 a era:TrainCompositionMessage ;
    era:messageHeader [ era:messageDateTimeCreated "2026-10-15T05:50:00Z"^^xsd:dateTime ] ;
    era:operationalTrainNumberIdentifier [ era:operationalTrainNumber "41234" ] ;
    era:trainCompositionJourneySection d:js1 ;
    ens:aboutRunningTrain d:run1 .
d:js1 a era:TrainCompositionJourneySection ;
    era:locoNumber "91 80 6189 001-3" ;
    era:regenerativeBrake [ era:regenerativeBrakeFitted true ] ;
    era:journeySection [ era:journeySectionOrigin [ era:bookedLocationDateTime "2026-10-15T06:00:00Z"^^xsd:dateTime ] ] ;
    era:trainRunningData [ era:trainRunningTechData [ era:trainWeight 1450 ] ] .

d:tcm2 a era:TrainCompositionMessage ;            # timing evidence is illustrative, not legal validation
    era:messageHeader [ era:messageDateTimeCreated "2026-10-15T17:00:00Z"^^xsd:dateTime ] ;
    era:operationalTrainNumberIdentifier [ era:operationalTrainNumber "41888" ] ;
    era:trainCompositionJourneySection d:js2 ;
    ens:aboutRunningTrain d:run2 .
d:js2 a era:TrainCompositionJourneySection ;
    era:locoNumber "917421940025" ;
    era:journeySection [ era:journeySectionOrigin [ era:bookedLocationDateTime "2026-10-15T07:00:00Z"^^xsd:dateTime ] ] ;
    era:trainRunningData [ era:trainRunningTechData [ era:trainWeight 980 ] ] .

# One location report per message: era:trainLocationReport and
# era:locationDateTime are functional in ERA rc.3.
d:tri1 a era:TrainRunningInformationMessage ;
    era:operationalTrainNumberIdentifier [ era:operationalTrainNumber "41234" ] ;
    era:responsibleRU "3801" ;
    ens:responsibleRailwayUndertaking d:nordCargoRU ;
    ens:aboutRunningTrain d:run1 ;
    era:trainLocationReport [ era:location d:plKongsvinger ; era:locationDateTime "2026-10-15T07:10:00Z"^^xsd:dateTime ] .

d:tri2 a era:TrainRunningInformationMessage ;
    era:operationalTrainNumberIdentifier [ era:operationalTrainNumber "41234" ] ;
    era:responsibleRU "3801" ;
    ens:responsibleRailwayUndertaking d:nordCargoRU ;
    ens:aboutRunningTrain d:run1 ;
    era:trainLocationReport [ era:location d:plMagnor ; era:locationDateTime "2026-10-15T08:30:00Z"^^xsd:dateTime ] .

d:tri3 a era:TrainRunningInformationMessage ;
    era:operationalTrainNumberIdentifier [ era:operationalTrainNumber "41234" ] ;
    era:responsibleRU "3801" ;
    ens:responsibleRailwayUndertaking d:nordCargoRU ;
    ens:aboutRunningTrain d:run1 ;
    era:trainLocationReport [ era:location d:plCharlottenberg ; era:locationDateTime "2026-10-15T08:38:00Z"^^xsd:dateTime ] .

d:run1 a ens:RunningTrain ;
    era:operationalTrainNumber "41234" ;
    era:trainDepartureDate "2026-10-15"^^xsd:date ;
    era:trainOperatingRU "3801" ;
    ens:operatingRailwayUndertaking d:nordCargoRU ;
    ens:runStart "2026-10-15T06:00:00Z"^^xsd:dateTime ;
    ens:runEnd "2026-10-15T08:38:00Z"^^xsd:dateTime ;
    ens:consumerRole d:ruRole ;
    ens:actualDepartureTime "2026-10-15T06:02:00Z"^^xsd:dateTime ;
    ens:actualDepartureEvidence d:departureEvent .

d:run2 a ens:RunningTrain ;
    era:operationalTrainNumber "41888" ;
    era:trainDepartureDate "2026-10-15"^^xsd:date ;
    era:trainOperatingRU "3801" ;
    ens:operatingRailwayUndertaking d:nordCargoRU ;
    ens:runStart "2026-10-15T07:00:00Z"^^xsd:dateTime ;
    ens:runEnd "2026-10-15T12:00:00Z"^^xsd:dateTime ;
    ens:consumerRole d:ruRole ;
    ens:actualDepartureTime "2026-10-15T07:02:00Z"^^xsd:dateTime ;
    ens:actualDepartureEvidence d:departureEvent2 .

d:tcm2 ens:timelinessAssessment ensc:exceptionEvidenceRecorded ;
    ens:timelinessEvidence d:lateMessageEvidence ;
    ens:timelinessAuthority d:authorityToVerify .

# Exchange instances are illustrative audit events. Authorities and retention
# rules must be replaced by deployment-approved references.
d:exchangeTcm1NO a ens:DataExchangeActivity ;
    ens:exchangedMessage d:tcm1 ; ens:exchangeSender d:imNO ;
    ens:exchangeRecipient d:settleOpNO ; ens:exchangeTime "2026-10-15T05:51:00Z"^^xsd:dateTime ; ens:messageVersion "1" ;
    ens:exchangeOutcome ensc:received ; ens:exchangePurpose ensc:energySettlement ;
    ens:exchangeAuthority d:authorityToVerify ; ens:retentionPolicy d:retentionToApprove .
d:exchangeTcm1SE a ens:DataExchangeActivity ;
    ens:exchangedMessage d:tcm1 ; ens:exchangeSender d:imSE ;
    ens:exchangeRecipient d:settleOpSE ; ens:exchangeTime "2026-10-15T05:52:00Z"^^xsd:dateTime ; ens:messageVersion "1" ;
    ens:exchangeOutcome ensc:received ; ens:exchangePurpose ensc:energySettlement ;
    ens:exchangeAuthority d:authorityToVerify ; ens:retentionPolicy d:retentionToApprove .
d:exchangeTri1NO a ens:DataExchangeActivity ;
    ens:exchangedMessage d:tri1 ; ens:exchangeSender d:imNO ;
    ens:exchangeRecipient d:settleOpNO ; ens:exchangeTime "2026-10-15T07:11:00Z"^^xsd:dateTime ; ens:messageVersion "1" ;
    ens:exchangeOutcome ensc:received ; ens:exchangePurpose ensc:energySettlement ;
    ens:exchangeAuthority d:authorityToVerify ; ens:retentionPolicy d:retentionToApprove .
d:exchangeTri2NO a ens:DataExchangeActivity ;
    ens:exchangedMessage d:tri2 ; ens:exchangeSender d:imNO ;
    ens:exchangeRecipient d:settleOpNO ; ens:exchangeTime "2026-10-15T08:31:00Z"^^xsd:dateTime ; ens:messageVersion "1" ;
    ens:exchangeOutcome ensc:received ; ens:exchangePurpose ensc:energySettlement ;
    ens:exchangeAuthority d:authorityToVerify ; ens:retentionPolicy d:retentionToApprove .
d:exchangeTri3SE a ens:DataExchangeActivity ;
    ens:exchangedMessage d:tri3 ; ens:exchangeSender d:imSE ;
    ens:exchangeRecipient d:settleOpSE ; ens:exchangeTime "2026-10-15T08:40:00Z"^^xsd:dateTime ; ens:messageVersion "1" ;
    ens:exchangeOutcome ensc:received ; ens:exchangePurpose ensc:energySettlement ;
    ens:exchangeAuthority d:authorityToVerify ; ens:retentionPolicy d:retentionToApprove .
d:exchangeTcm2NO a ens:DataExchangeActivity ;
    ens:exchangedMessage d:tcm2 ; ens:exchangeSender d:imNO ;
    ens:exchangeRecipient d:settleOpNO ; ens:exchangeTime "2026-10-15T17:01:00Z"^^xsd:dateTime ; ens:messageVersion "1" ;
    ens:exchangeOutcome ensc:received ; ens:exchangePurpose ensc:energySettlement ;
    ens:exchangeAuthority d:authorityToVerify ; ens:retentionPolicy d:retentionToApprove .

# --- Settlement outcome ----------------------------------------------

d:alloc1 a ens:EnergyAllocation ;
    ens:allocatesReading d:r1 , d:r2 ;
    ens:hasAllocationComponent d:alloc1r1 , d:alloc1r2 ;
    ens:allocatedTo d:ruRole ; ens:allocatedInZone d:zoneNO ;
    ens:allocationStatus ensc:meteredValid ; ens:producedBy d:settleNO ;
    ens:matchedComposition d:tcm1 ; ens:matchedRunningInformation d:tri1 ;
    ens:matchedRunningTrain d:run1 ;
    ens:allocatedActiveEnergyConsumed 790.5 ;
    ens:allocatedActiveEnergyRegenerated 20.5 ;
    ens:allocatedNetActiveEnergy 770.0 ;
    ens:allocationMethod ensc:meteredByConsumptionPoint ;
    ens:allocationRule d:allocationRuleV1 ; ens:allocationVersion "1" .

d:alloc2 a ens:EnergyAllocation ;
    ens:allocatesReading d:r3 ;
    ens:hasAllocationComponent d:alloc2r3 ;
    ens:allocatedTo d:ruRole ; ens:allocatedInZone d:zoneSE ;
    ens:allocationStatus ensc:meteredValid ; ens:producedBy d:settleSE ;
    ens:matchedComposition d:tcm1 ; ens:matchedRunningInformation d:tri3 ;
    ens:matchedRunningTrain d:run1 ;
    ens:allocatedActiveEnergyConsumed 95.2 ;
    ens:allocatedActiveEnergyRegenerated 3.1 ;
    ens:allocatedNetActiveEnergy 92.1 ;
    ens:allocationMethod ensc:meteredByConsumptionPoint ;
    ens:allocationRule d:allocationRuleV1 ; ens:allocationVersion "1" .

d:alloc3 a ens:EnergyAllocation ;                  # estimated, no reading used
    ens:hasAllocationComponent d:alloc3estimate ;
    ens:allocatedTo d:ruRole ; ens:allocatedInZone d:zoneNO ;
    ens:allocationStatus ensc:estimated ; ens:producedBy d:settleNO ;
    ens:matchedComposition d:tcm2 ; ens:matchedRunningTrain d:run2 ;
    ens:allocatedActiveEnergyConsumed 250.0 ;
    ens:allocatedActiveEnergyRegenerated 0.0 ;
    ens:allocatedNetActiveEnergy 250.0 ;
