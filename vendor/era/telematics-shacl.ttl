    sh:class skos:Concept ;
    sh:description "Customer Type: CR Consignor, CE Consignee"@en ;
    sh:maxCount 1 ;
    sh:minCount 0 ;
    sh:name "Type"@en ;
    sh:nodeKind sh:IRI ;
    sh:path era:type ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "The value must be a SKOS concept in the scheme http://data.europa.eu/949/concepts/type/Type."@en ;
            sh:prefixes "skos:" ;
            sh:select """
                    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
                    SELECT $this
                    WHERE {
                        $this $PATH ?concept .
                        FILTER NOT EXISTS{
                            ?concept skos:inScheme <http://data.europa.eu/949/concepts/type/Type> .
                        }
                    }
                """ ] .

