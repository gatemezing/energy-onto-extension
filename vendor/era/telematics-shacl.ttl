    dcterms:references "https://osdm.io/osdm/update/2026/03/25/OSDM-V3.8-released"^^xsd:anyURI ;
    sh:description """Passenger Category predefines a set of passenger specification properties that result to offer of a specific passenger type. 
`title` is the localized name of the passenger category and `specification` describes exact passenger specification that may results into offer for selected passenger category. Passenger category specification doesn't guarantee availability of expected passenger type on offered trip. `appliedPassengerType` must always be checked in the offer response.
"""@en ;
    sh:name "Passenger Category"@en ;
    sh:nodeKind sh:IRI ;
    sh:property <http://data.europa.eu/949/shapes/PropertyShape/PassengerCategory/additional>,
        <http://data.europa.eu/949/shapes/PropertyShape/PassengerCategory/base>,
