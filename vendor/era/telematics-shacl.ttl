    sh:class skos:Concept ;
    sh:description """scope of a price:  

1 - reservation fee only
2 - price per passenger
3 - price per compartment
4 - price for exact number of requested passengers only (nonlinear dependency between price and number of passengers)"""@en ;
    sh:name "Type of price scope"@en ;
    sh:nodeKind sh:IRI ;
    sh:path era:priceScopeType ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "The value must be a SKOS concept in the scheme http://data.europa.eu/949/concepts/price-scope-type/PriceScopeType."@en ;
            sh:prefixes "skos:" ;
            sh:select """
