<http://data.europa.eu/949/shapes/PropertyShape/RollingStockDataset/AdministrativeDataSet/InteropCapability> a sh:PropertyShape ;
    era:usedInTelematics true ;
    dcterms:created "2026-10-02T13:08:22+00:00"^^xsd:dateTime ;
    dcterms:references "https://gitlab.com/era-europa-eu/public/era-telematics-tsi/tsi_telematics/-/blob/V4.0.0/TD_105_xsd/taf_cat_complete.xsd"^^xsd:anyURI ;
    sh:class skos:Concept ;
    sh:description """Identification of the general interoperability capability of the wagon
The following values/codes are proposed for the usage (defined in the InteropCapabilityCode):

01 = National
02 = Bi-/Multilateral (with agreement or authorisation grid)

03 = RIV
05 = TEN

06 = TEN-GE

07 = TEN-CW

08 = TEN RIV"""@en,
        "Identification of the general interoperability capability of the wagon."@en ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Interop capability"@en ;
    sh:nodeKind sh:IRI ;
    sh:path era:interopCapability ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "The value must be a SKOS concept in the scheme http://data.europa.eu/949/concepts/interop-capability/InteropCapability."@en ;
            sh:prefixes "skos:" ;
            sh:select """
                    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
                    SELECT $this
                    WHERE {
                        $this $PATH ?concept .
                        FILTER NOT EXISTS{
                            ?concept skos:inScheme <http://data.europa.eu/949/concepts/interop-capability/InteropCapability> .
                        }
                    }
                """ ] .

