<http://data.europa.eu/949/shapes/PropertyShape/VehicleCategoryType> a sh:PropertyShape ;
    era:usedInTelematics true ;
    dcterms:created "2026-10-02T13:08:22+00:00"^^xsd:dateTime ;
    dcterms:references "https://gitlab.com/era-europa-eu/public/era-telematics-tsi/tsi_telematics/-/blob/V4.0.0/TD_B5_A2_xsd/"^^xsd:anyURI ;
    sh:class skos:Concept ;
    sh:description """
					1 - Motor vehicle less than 3,81 m in length and with a roof width up to 1,35 m.
					2 - Motor vehicle between 3,81 m up to 4,42 m in length and with a roof width up to 1,35 m
					3 - Motor vehicle or boat between 4,42 m up to 5,30 m in length and with a roof width up to 1,35 m
					4 - Motorcycle
					5 - Motorcycle and sidecar
					6 - Motor vehicle less than 3,81 m in length and with a roof width between 1,36 m and 1,55 m
					7 - Motor vehicle between 3,81 m and 4,42 m in length and with a roof width between 1,36 m and 1,55 m
					8 - Motor vehicle or boat between 4,42 m up to 5,30 m in length and with a roof width between 1,36 m and 1,55 m
					"""@en,
        "Leaflet 918 element 29"@en ;
    sh:name "Type of vehicle category"@en ;
    sh:nodeKind sh:IRI ;
    sh:path era:vehicleCategoryType ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "The value must be a SKOS concept in the scheme http://data.europa.eu/949/concepts/vehicle-category-type/VehicleCategoryType."@en ;
            sh:prefixes "skos:" ;
            sh:select """
                    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
                    SELECT $this
                    WHERE {
                        $this $PATH ?concept .
                        FILTER NOT EXISTS{
                            ?concept skos:inScheme <http://data.europa.eu/949/concepts/vehicle-category-type/VehicleCategoryType> .
                        }
                    }
                """ ] .

