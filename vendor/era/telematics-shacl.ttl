    sh:class skos:Concept ;
    sh:description """1 = passport
2 = id-card
3 = diplomatic passport
4 = refugee travel document"""@en ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Type of document"@en ;
    sh:nodeKind sh:IRI ;
    sh:path era:passengerDocumentTypeCode ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "The value must be a SKOS concept in the scheme http://data.europa.eu/949/concepts/document-type-type/DocumentTypeType."@en ;
            sh:prefixes "skos:" ;
            sh:select """
                    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
                    SELECT $this
                    WHERE {
                        $this $PATH ?concept .
                        FILTER NOT EXISTS{
                            ?concept skos:inScheme <http://data.europa.eu/949/concepts/document-type-type/DocumentTypeType> .
                        }
                    }
                """ ] .

