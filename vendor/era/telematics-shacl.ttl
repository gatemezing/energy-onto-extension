    sh:class skos:Concept ;
    sh:description """Status of the carrier during the transport                       
			0  Contractual carrier / Lead carrier                                
			1  Succesive carrier             
			2  Substitute carrier             
			3   to be used for all other partners (e.g. subcontractors, relevant applicants) beside the carriers in role 0, 1 and 2 (which have to be mentioned in the consignment note)"""@en ;
    sh:name "Carrier status"@en ;
    sh:nodeKind sh:IRI ;
    sh:path era:carrierStatus ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "The value must be a SKOS concept in the scheme http://data.europa.eu/949/concepts/carrier-status/CarrierStatus."@en ;
            sh:prefixes "skos:" ;
            sh:select """
                    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
                    SELECT $this
                    WHERE {
                        $this $PATH ?concept .
                        FILTER NOT EXISTS{
                            ?concept skos:inScheme <http://data.europa.eu/949/concepts/carrier-status/CarrierStatus> .
                        }
                    }
                """ ] .

