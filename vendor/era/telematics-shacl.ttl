<http://data.europa.eu/949/shapes/NodeShape/VAT> a sh:NodeShape ;
    era:usedInTelematics true ;
    dcterms:created "2026-10-02T13:09:07+00:00"^^xsd:dateTime ;
    dcterms:references "https://osdm.io/osdm/update/2026/03/25/OSDM-V3.8-released"^^xsd:anyURI ;
    sh:description """The VAT structure details a VAT amount (in case of international travel, there may be multiple VAT structures).
The netAmount is the amount before adding the VAT; the grossAmount is the amount including VAT, where
the amount is the actual VAT being described here. So the equation netAmount + amount = grossAmount holds.
Furthermore, the equation netAmount * percentage = amount also holds, but is susceptible to possible rounding
errors.
All the grossAmounts of the VAT structures should add up to the overall amount of the enclosing price structure.
The currency is inherited from the currency of the associated price.
"""@en ;
    sh:name "Vat"@en ;
    sh:nodeKind sh:IRI ;
    sh:property <http://data.europa.eu/949/shapes/PropertyShape/VAT/amount>,
        <http://data.europa.eu/949/shapes/PropertyShape/VAT/countryCode>,
        <http://data.europa.eu/949/shapes/PropertyShape/VAT/grossAmount>,
        <http://data.europa.eu/949/shapes/PropertyShape/VAT/grossAmountScale>,
        <http://data.europa.eu/949/shapes/PropertyShape/VAT/netAmount>,
        <http://data.europa.eu/949/shapes/PropertyShape/VAT/netAmountScale>,
        <http://data.europa.eu/949/shapes/PropertyShape/VAT/percentage>,
        <http://data.europa.eu/949/shapes/PropertyShape/VAT/scale>,
        <http://data.europa.eu/949/shapes/PropertyShape/VAT/scope>,
        <http://data.europa.eu/949/shapes/PropertyShape/VAT/taxId>,
        <http://data.europa.eu/949/shapes/PropertyShape/VAT/taxIdOnInvoice>,
        <http://data.europa.eu/949/shapes/PropertyShape/VAT/vatOnInvoice> ;
    sh:targetClass era:VAT .

