<http://data.europa.eu/949/shapes/PropertyShape/OffsetToReference> a sh:PropertyShape ;
    era:usedInTelematics true ;
    dcterms:created "2026-10-02T13:08:22+00:00"^^xsd:dateTime ;
    dcterms:references "https://gitlab.com/era-europa-eu/public/era-telematics-tsi/tsi_telematics/-/blob/V4.0.0/TD_105_xsd/taf_cat_complete.xsd"^^xsd:anyURI ;
    sh:datatype xsd:integer ;
    sh:description " The OffsetToReference (OTR) is the shift of the days between Planned Calendar of the related object (route, path request or path) to the days in Reference Calendar. The shift is mentioned in days. OTR value is set to zero when there is no gap between Planned Calendar and Reference Calendar, OTR value is positive if Planned Calendar later than Reference Calendar and negative if Planned Calendar earlier than Reference Calendar.>"@en ;
    sh:name "Offset to reference"@en ;
    sh:path era:offsetToReference .

