<http://data.europa.eu/949/shapes/PropertyShape/ConsignmentOrderMessage/COMS/COM_Header/PrintForm> a sh:PropertyShape ;
    era:usedInTelematics true ;
    dcterms:created "2026-10-02T13:08:22+00:00"^^xsd:dateTime ;
    dcterms:references "https://gitlab.com/era-europa-eu/public/era-telematics-tsi/tsi_telematics/-/blob/V4.0.0/TD_105_xsd/taf_cat_complete.xsd"^^xsd:anyURI ;
    sh:class skos:Concept ;
    sh:description "Which form to use for printout. CIM-CN or CIM-CN for combined traffic. This information assures, that the same paper document will be used for the 'duplicate of the consignment note' and the final print out of the ECN for the consignee."@en ;
    sh:maxCount 1 ;
    sh:minCount 0 ;
    sh:name "Print form"@en ;
    sh:nodeKind sh:IRI ;
    sh:path era:printForm ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "The value must be a SKOS concept in the scheme http://data.europa.eu/949/concepts/print-form/PrintForm."@en ;
            sh:prefixes "skos:" ;
            sh:select """
                    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
                    SELECT $this
                    WHERE {
                        $this $PATH ?concept .
                        FILTER NOT EXISTS{
                            ?concept skos:inScheme <http://data.europa.eu/949/concepts/print-form/PrintForm> .
                        }
                    }
                """ ] .

