                    WHERE {
                        $this $PATH ?concept .
                        FILTER NOT EXISTS{
                            ?concept skos:inScheme <http://data.europa.eu/949/concepts/terminal-type-type/TerminalTypeType> .
                        }
                    }
                """ ] .

