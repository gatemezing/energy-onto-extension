    sh:nodeKind sh:IRI ;
    sh:path era:stationCodeTable ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "The value must be a SKOS concept in the scheme http://data.europa.eu/949/concepts/code-table-type/CodeTableType."@en ;
            sh:select """
            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
            SELECT $this WHERE {
                $this $PATH ?concept .
                FILTER NOT EXISTS { ?concept skos:inScheme <http://data.europa.eu/949/concepts/code-table-type/CodeTableType> . }
            }
        """ ] .

