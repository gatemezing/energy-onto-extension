<http://data.europa.eu/949/shapes/PropertyShape/PositionOfCompartmentType> a sh:PropertyShape ;
    era:usedInTelematics true ;
    dcterms:created "2026-10-02T13:08:22+00:00"^^xsd:dateTime ;
    dcterms:references "https://gitlab.com/era-europa-eu/public/era-telematics-tsi/tsi_telematics/-/blob/V4.0.0/TD_B5_A2_xsd/"^^xsd:anyURI ;
    sh:class skos:Concept ;
    sh:description """
					1 - lower level. Request is  treated as optional
					2 - upper level. Request is treated as optional
					3 - compartment on both levels. value to be applied in response mesages only 
					"""@en,
        "Leaflet 918 element 38"@en ;
    sh:name "Type of position of compartment"@en ;
    sh:nodeKind sh:IRI ;
    sh:path era:positionOfCompartmentType ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "The value must be a SKOS concept in the scheme http://data.europa.eu/949/concepts/position-of-compartment-type/PositionOfCompartmentType."@en ;
            sh:prefixes "skos:" ;
            sh:select """
                    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
                    SELECT $this
                    WHERE {
                        $this $PATH ?concept .
                        FILTER NOT EXISTS{
                            ?concept skos:inScheme <http://data.europa.eu/949/concepts/position-of-compartment-type/PositionOfCompartmentType> .
                        }
                    }
                """ ] .

<http://data.europa.eu/949/shapes/PropertyShape/PositionOfPlaceType> a sh:PropertyShape ;
