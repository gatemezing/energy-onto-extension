<http://data.europa.eu/949/shapes/PropertyShape/RollingStockDataset/DesignDataSet/LoadTable/LoadTableStars> a sh:PropertyShape ;
    era:usedInTelematics true ;
    dcterms:created "2026-10-02T13:08:22+00:00"^^xsd:dateTime ;
    dcterms:references "https://gitlab.com/era-europa-eu/public/era-telematics-tsi/tsi_telematics/-/blob/V4.0.0/TD_105_xsd/taf_cat_complete.xsd"^^xsd:anyURI ;
    sh:class skos:Concept ;
    sh:description "Number of load table stars."@en,
        """Number of load table stars. Currently recognized values/codes:
1 = Authorised to run loaded in trains up to 100 km/h with a brake that does not meet all the requirements for 100 km/h conditions
2 = Authorised to run loaded in trains up to 120 km/h with a brake that does not meet all the requirements for 120 km/h conditions
3 = Authorised to run loaded in trains up to 120 km/h with a brake that does not meet all the requirements for 120 km/h conditions. Wagon is fitted with an automatic load-proportional braking system.
 """@en ;
    sh:maxCount 1 ;
    sh:minCount 0 ;
    sh:name "Load table stars"@en ;
    sh:nodeKind sh:IRI ;
    sh:path era:loadTableStars ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "The value must be a SKOS concept in the scheme http://data.europa.eu/949/concepts/load-table-stars/LoadTableStars."@en ;
            sh:prefixes "skos:" ;
            sh:select """
                    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
                    SELECT $this
                    WHERE {
                        $this $PATH ?concept .
                        FILTER NOT EXISTS{
                            ?concept skos:inScheme <http://data.europa.eu/949/concepts/load-table-stars/LoadTableStars> .
                        }
                    }
                """ ] .

