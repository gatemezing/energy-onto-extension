    dcterms:references "https://gitlab.com/era-europa-eu/public/era-telematics-tsi/tsi_telematics/-/blob/V4.0.0/TD_105_xsd/taf_cat_complete.xsd"^^xsd:anyURI ;
    sh:class skos:Concept ;
    sh:description "This element identifies the reason for an interruption of the train running"@en ;
    sh:maxCount 1 ;
    sh:minCount 0 ;
    sh:name "Interruption reason"@en ;
    sh:nodeKind sh:IRI ;
    sh:path era:interruptionReason ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "The value must be a SKOS concept in the scheme http://data.europa.eu/949/concepts/delay-code/DelayCode."@en ;
            sh:prefixes "skos:" ;
            sh:select """
                    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
                    SELECT $this
                    WHERE {
                        $this $PATH ?concept .
                        FILTER NOT EXISTS{
                            ?concept skos:inScheme <http://data.europa.eu/949/concepts/delay-code/DelayCode> .
                        }
                    }
                """ ] .

