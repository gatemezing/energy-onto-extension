                        }
                    }
                """ ] .

<http://data.europa.eu/949/shapes/PropertyShape/TrainCompositionJourneySection/LocoIdent/TractionPositionInTrain> a sh:PropertyShape ;
    era:usedInTelematics true ;
    dcterms:created "2026-10-02T13:08:22+00:00"^^xsd:dateTime ;
    dcterms:references "https://gitlab.com/era-europa-eu/public/era-telematics-tsi/tsi_telematics/-/blob/V4.0.0/TD_105_xsd/taf_cat_complete.xsd"^^xsd:anyURI ;
    sh:datatype xsd:integer ;
    sh:description "Identifies position of intermediate traction unit(s) in the train indicating after which wagon (specified by order number) the unit is placed."@en ;
    sh:maxCount 1 ;
    sh:maxInclusive "99" ;
    sh:minCount 0 ;
    sh:minInclusive "01" ;
    sh:name "Traction position in train"@en ;
    sh:path era:tractionPositionInTrain .

<http://data.europa.eu/949/shapes/PropertyShape/TrainCompositionJourneySection/LocoIdent/TractionType> a sh:PropertyShape ;
    era:usedInTelematics true ;
    dcterms:created "2026-10-02T13:08:22+00:00"^^xsd:dateTime ;
    dcterms:references "https://gitlab.com/era-europa-eu/public/era-telematics-tsi/tsi_telematics/-/blob/V4.0.0/TD_105_xsd/taf_cat_complete.xsd"^^xsd:anyURI ;
    sh:class skos:Concept ;
    sh:description """Identifies the type of a locomotive: 
First digit:
“0” = not specified
“1” = external electric power supply for traction (catenary and pantograph, third rail or other such as maglev)
“2” = on-board traction power supply for traction without external electrical or other power supply available
“3” = hybrid traction (both on-board or electric traction available)
Second digit (definitions in chapter 2.2.2 of the LOC and PAS TSI 1302/2014):
“0” = not specified
“1” = locomotive or power unit
“2” = trainset or multiple unit or railcar
“3” = shunter
“4” = on track machine or infrastructure inspection vehicle
			"""@en ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Type of traction"@en ;
    sh:nodeKind sh:IRI ;
    sh:path era:tractionType ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "The value must be a SKOS concept in the scheme http://data.europa.eu/949/concepts/traction-type/TractionType."@en ;
            sh:prefixes "skos:" ;
            sh:select """
                    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
                    SELECT $this
                    WHERE {
                        $this $PATH ?concept .
                        FILTER NOT EXISTS{
                            ?concept skos:inScheme <http://data.europa.eu/949/concepts/traction-type/TractionType> .
                        }
                    }
                """ ] .

