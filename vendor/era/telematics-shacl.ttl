    dcterms:created "2026-10-02T13:09:07+00:00"^^xsd:dateTime ;
    dcterms:references "https://osdm.io/osdm/update/2026/03/25/OSDM-V3.8-released"^^xsd:anyURI ;
    sh:description """Options to control the search behavior and response contents.
number of results > either number of results or number of results before and after are used.
Provided by OJP.
"""@en ;
    sh:name "Trip Parameters"@en ;
    sh:nodeKind sh:IRI ;
    sh:property <http://data.europa.eu/949/shapes/PropertyShape/TripParameters/dataFilter>,
        <http://data.europa.eu/949/shapes/PropertyShape/TripParameters/ignoreRealtimeData>,
        <http://data.europa.eu/949/shapes/PropertyShape/TripParameters/itModesToCover>,
        <http://data.europa.eu/949/shapes/PropertyShape/TripParameters/mobilityFilter>,
        <http://data.europa.eu/949/shapes/PropertyShape/TripParameters/numberOfResults>,
        <http://data.europa.eu/949/shapes/PropertyShape/TripParameters/numberOfResultsAfter>,
        <http://data.europa.eu/949/shapes/PropertyShape/TripParameters/numberOfResultsBefore>,
        <http://data.europa.eu/949/shapes/PropertyShape/TripParameters/policyFilter>,
        <http://data.europa.eu/949/shapes/PropertyShape/TripParameters/transferLimit> ;
    sh:targetClass era:TripParameters .

