    sh:class skos:Concept ;
    sh:description """
               W - window seat
               A - aile seat
               M - middle seat
               S - single window seat
               U - upper level berth or couchette
               I - middle level berth or couchette
               L - lower level berth or couchette
               """@en,
        "corresponding to Leaflet 918 element 36 (new coding schema) "@en ;
    sh:maxLength 1 ;
    sh:minLength 1 ;
    sh:name "Type of position of place"@en ;
    sh:nodeKind sh:IRI ;
    sh:path era:positionOfPlaceType ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "The value must be a SKOS concept in the scheme http://data.europa.eu/949/concepts/position-of-place-type/PositionOfPlaceType."@en ;
            sh:prefixes "skos:" ;
            sh:select """
                    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
                    SELECT $this
                    WHERE {
                        $this $PATH ?concept .
                        FILTER NOT EXISTS{
                            ?concept skos:inScheme <http://data.europa.eu/949/concepts/position-of-place-type/PositionOfPlaceType> .
                        }
                    }
                """ ] .

