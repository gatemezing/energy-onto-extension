<http://data.europa.eu/949/shapes/PropertyShape/PartialCancelBookingConfirmationType/CancelledTrailerSize> a sh:PropertyShape ;
    era:usedInTelematics true ;
    dcterms:created "2026-10-02T13:08:22+00:00"^^xsd:dateTime ;
    dcterms:references "https://gitlab.com/era-europa-eu/public/era-telematics-tsi/tsi_telematics/-/blob/V4.0.0/TD_B5_A2_xsd/"^^xsd:anyURI ;
    sh:class skos:Concept ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Cancelled trailer size"@en ;
    sh:nodeKind sh:IRI ;
    sh:path era:cancelledTrailerSize ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "The value must be a SKOS concept in the scheme http://data.europa.eu/949/concepts/trailer-size-type/TrailerSizeType."@en ;
            sh:prefixes "skos:" ;
            sh:select """
                    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
                    SELECT $this
                    WHERE {
                        $this $PATH ?concept .
                        FILTER NOT EXISTS{
                            ?concept skos:inScheme <http://data.europa.eu/949/concepts/trailer-size-type/TrailerSizeType> .
                        }
                    }
                """ ] .

