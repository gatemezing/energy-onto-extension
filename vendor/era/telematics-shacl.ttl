    sh:datatype xsd:string ;
    sh:description "The UNNumber of the dangerous good according to the RID chapter 3.2, table A, column 1. Mandatory, except it concerns a declaration of an empty packaging of the type \"EMPTY PACKAGING\", \"EMPTY RECEPTACLE <=1000L\", \"EMPTY IBC\" or \"EMPTY LARGE PACKAGING\" ."@en ;
    sh:maxCount 1 ;
    sh:maxLength 4 ;
    sh:minCount 0 ;
    sh:minLength 4 ;
    sh:name "U n number"@en ;
