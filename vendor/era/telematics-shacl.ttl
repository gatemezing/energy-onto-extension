"""@en ;
    sh:maxLength 32768 ;
    sh:minCount 0 ;
    sh:name "Outward Offer Ids"@en ;
    sh:order 3 ;
    sh:path era:outwardOfferIds .

<http://data.europa.eu/949/shapes/PropertyShape/ReturnSearchParameters/outwardOfferTag> a sh:PropertyShape ;
    era:usedInTelematics true ;
    dcterms:created "2026-10-02T13:09:07+00:00"^^xsd:dateTime ;
