<http://data.europa.eu/949/shapes/PropertyShape/RID_Checking/CheckingLocation> a sh:PropertyShape ;
    era:usedInTelematics true ;
    dcterms:created "2026-10-02T13:08:22+00:00"^^xsd:dateTime ;
    dcterms:references "https://gitlab.com/era-europa-eu/public/era-telematics-tsi/tsi_telematics/-/blob/V4.0.0/TD_105_xsd/taf_cat_complete.xsd"^^xsd:anyURI ;
    sh:description "The location where the check took place"@en ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Checking location"@en ;
    sh:node <http://data.europa.eu/949/shapes/NodeShape/PrimaryLocation> ;
    sh:nodeKind sh:IRI ;
    sh:path era:checkingLocation .

<http://data.europa.eu/949/shapes/PropertyShape/RID_Checking/CheckingResults> a sh:PropertyShape ;
    era:usedInTelematics true ;
    dcterms:created "2026-10-02T13:08:22+00:00"^^xsd:dateTime ;
    dcterms:references "https://gitlab.com/era-europa-eu/public/era-telematics-tsi/tsi_telematics/-/blob/V4.0.0/TD_105_xsd/taf_cat_complete.xsd"^^xsd:anyURI ;
    sh:datatype xsd:string ;
    sh:description """Description of the checks' results (in conjunction with the element CheckingType) and possible need for follow-up:

01 Results OK, no follow up needed during transportation
02 Results OK, but follow up needed during transportation
03 Results not OK, transportation rejected"""@en ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Checking results"@en ;
    sh:path era:checkingResults ;
    sh:pattern "^(01|02|03)$" .

<http://data.europa.eu/949/shapes/PropertyShape/RID_Checking/CheckingType> a sh:PropertyShape ;
    era:usedInTelematics true ;
    dcterms:created "2026-10-02T13:08:22+00:00"^^xsd:dateTime ;
    dcterms:references "https://gitlab.com/era-europa-eu/public/era-telematics-tsi/tsi_telematics/-/blob/V4.0.0/TD_105_xsd/taf_cat_complete.xsd"^^xsd:anyURI ;
    sh:class skos:Concept ;
    sh:description """Following types of checks are authorised (RID 1.4.3):

Carrier:
01 Prescribed documentation attached to transport docuemnt
02 Defects, leackages, cracks, missing equipment on wagons or equipment

Loader:
11 Damage of packing
12 Compliance with prohibition on mixed loading
13 Uncleaned empty package

Filler:
21 Date of next inspection of wagons
22 DG is filled only into authorized tanks
23 Permissible level of filling
24 Plackards, plates from RID chapter 5.3 are visible on wagon
25 Correct Closure of wagons / tanks
26 Leackage on wagons / tanks

Unloader:
31 Damage of packages or of tanks
32 Required DG documentation available
33 Cleaning, degasing, decontamination of wagons from residues
34 Plackards, plates from RID chapter 5.3 are removed from wagon
"""@en ;
    sh:minCount 1 ;
    sh:name "Type of checking"@en ;
    sh:nodeKind sh:IRI ;
    sh:path era:checkingType ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "The value must be a SKOS concept in the scheme http://data.europa.eu/949/concepts/checking-type/CheckingType."@en ;
            sh:prefixes "skos:" ;
            sh:select """
                    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
                    SELECT $this
                    WHERE {
                        $this $PATH ?concept .
                        FILTER NOT EXISTS{
                            ?concept skos:inScheme <http://data.europa.eu/949/concepts/checking-type/CheckingType> .
                        }
                    }
                """ ] .

