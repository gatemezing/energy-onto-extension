    dcterms:references "https://osdm.io/osdm/update/2026/03/25/OSDM-V3.8-released"^^xsd:anyURI ;
    sh:class skos:Concept ;
    sh:maxCount 1 ;
    sh:minCount 0 ;
    sh:name "Travel Class"@en ;
    sh:nodeKind sh:IRI ;
    sh:order 12 ;
    sh:path era:assignedTravelClass ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "The value must be a SKOS concept in the scheme http://data.europa.eu/949/concepts/travel-class/TravelClass."@en ;
            sh:select """
                PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
                SELECT $this WHERE {
                    $this $PATH ?concept .
                    FILTER NOT EXISTS { ?concept skos:inScheme <http://data.europa.eu/949/concepts/travel-class/TravelClass> . }
                }
            """ ] .

