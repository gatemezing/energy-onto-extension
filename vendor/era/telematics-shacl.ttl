<http://data.europa.eu/949/shapes/PropertyShape/ExchangeOfferCollectionRequest/exchangeFee> a sh:PropertyShape ;
    era:usedInTelematics true ;
    dcterms:created "2026-10-02T13:09:07+00:00"^^xsd:dateTime ;
    dcterms:references "https://osdm.io/osdm/update/2026/03/25/OSDM-V3.8-released"^^xsd:anyURI ;
    sh:description """In some business models the distributor has the right to define the exchange fee amount for a fare provided by the fare provider. This need to be indicated in the fare after sales rules to be applied. In this case the distributor submits the amount to the fare provider in exchange fee amount and the fare provider uses this amount to create the fees including the VAT split.
"""@en ;
    sh:maxCount 1 ;
    sh:minCount 0 ;
    sh:name "Exchange Fee"@en ;
    sh:node <http://data.europa.eu/949/shapes/NodeShape/CurrencyAmount> ;
    sh:nodeKind sh:IRI ;
    sh:order 13 ;
    sh:path era:requestedExchangeFee .

