    sh:nodeKind sh:IRI ;
    sh:path era:objectTypeReference ;
    sh:pattern "[0-9A-Z]{2}" ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "The value must be a SKOS concept in the scheme http://data.europa.eu/949/concepts/object-type/ObjectType."@en ;
            sh:prefixes "skos:" ;
            sh:select """
                    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
                    SELECT $this
                    WHERE {
                        $this $PATH ?concept .
                        FILTER NOT EXISTS{
                            ?concept skos:inScheme <http://data.europa.eu/949/concepts/object-type/ObjectType> .
                        }
                    }
                """ ] .

