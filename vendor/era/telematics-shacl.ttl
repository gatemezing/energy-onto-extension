        <http://data.europa.eu/949/shapes/PropertyShape/TrainRunningInformationMessage/TrainOperationalIdentification>,
        <http://data.europa.eu/949/shapes/PropertyShape/TrainRunningInformationMessage/TransferPoint>,
        <http://data.europa.eu/949/shapes/PropertyShape/TrainRunningInformationMessage/TransfereeIM> ;
    sh:targetClass era:TrainRunningInformationMessage .

