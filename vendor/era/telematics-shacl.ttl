    sh:datatype xsd:string ;
    sh:description "Internal identification number of  the Wo. This information is important to be able to identify the COM even after modifications. Format: RRRRYYYYMMDDNNNNNNN Where RRRR = railway code, YYYY = year, MM = month, DD = day and NNNNNNN = running number."@en ;
    sh:maxCount 1 ;
    sh:maxLength 19 ;
    sh:minCount 0 ;
    sh:minLength 19 ;
    sh:name "Dossier number"@en ;
    sh:path era:dossierNumber ;
    sh:pattern "\\d{4}20\\d{2}[0-1][0-9][0-3]\\d{8}" .

