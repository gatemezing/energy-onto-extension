    sh:class skos:Concept ;
    sh:description "Indicates that livestock and people (other than train crew) will be carried. Coding: if live animals or people are transported = 1, in opposite case = 0. If code = 1, then at the wagon level for at least one wagon Info- Goods Shape, Type and Danger has to include the code '98' or Restrictions due to Load or Damage has to include code '09.'"@en ;
    sh:maxCount 1 ;
    sh:minCount 0 ;
    sh:name "Livestock or people indicator"@en ;
    sh:nodeKind sh:IRI ;
    sh:path era:livestockOrPeopleIndicator ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "The value must be a SKOS concept in the scheme http://data.europa.eu/949/concepts/livestock-or-people-indicator/LivestockOrPeopleIndicator."@en ;
            sh:prefixes "skos:" ;
            sh:select """
                    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
                    SELECT $this
                    WHERE {
                        $this $PATH ?concept .
                        FILTER NOT EXISTS{
                            ?concept skos:inScheme <http://data.europa.eu/949/concepts/livestock-or-people-indicator/LivestockOrPeopleIndicator> .
                        }
                    }
                """ ] .

