<http://data.europa.eu/949/shapes/PropertyShape/ReturnSearchParameters/inwardReturnDate> a sh:PropertyShape ;
    era:usedInTelematics true ;
    dcterms:created "2026-10-02T13:09:07+00:00"^^xsd:dateTime ;
    dcterms:references "https://osdm.io/osdm/update/2026/03/25/OSDM-V3.8-released"^^xsd:anyURI ;
    sh:datatype xsd:string ;
    sh:description """Needs to be provided when creating the collection of outbound travels so that the
provider knows when a inbound travel can be expected and propose appropriate
product and fares.

Superseded by `OfferSearchCriteria.inboundDate`.
"""@en ;
    sh:maxCount 1 ;
    sh:minCount 0 ;
    sh:name "Inward Return Date"@en ;
    sh:order 1 ;
    sh:path era:inwardReturnDate ;
    sh:pattern "(\\d{4}-[01]\\d-[0-3]\\dT[0-2]\\d:[0-5]\\d:[0-5]\\d)" .

<http://data.europa.eu/949/shapes/PropertyShape/ReturnSearchParameters/outboundTripIds> a sh:PropertyShape ;
    era:usedInTelematics true ;
    dcterms:created "2026-10-02T13:09:07+00:00"^^xsd:dateTime ;
    dcterms:references "https://osdm.io/osdm/update/2026/03/25/OSDM-V3.8-released"^^xsd:anyURI ;
    sh:datatype xsd:string ;
    sh:description """Needs to be provided when creating collection of offers covering both
outbound and inbound (return) journey.
"""@en ;
    sh:maxLength 32768 ;
    sh:minCount 0 ;
    sh:name "Outbound Trip Ids"@en ;
    sh:order 2 ;
    sh:path era:outboundTripIds .

<http://data.europa.eu/949/shapes/PropertyShape/ReturnSearchParameters/outwardOfferIds> a sh:PropertyShape ;
    era:usedInTelematics true ;
    dcterms:created "2026-10-02T13:09:07+00:00"^^xsd:dateTime ;
    dcterms:references "https://osdm.io/osdm/update/2026/03/25/OSDM-V3.8-released"^^xsd:anyURI ;
