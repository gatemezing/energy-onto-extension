<http://data.europa.eu/949/shapes/PropertyShape/ConsignmentOrderMessage/COMS/COM/Carriers/CarrierStatus> a sh:PropertyShape ;
    era:usedInTelematics true ;
    dcterms:created "2026-10-02T13:08:22+00:00"^^xsd:dateTime ;
