<http://data.europa.eu/949/shapes/PropertyShape/ConsignmentOrderMessage/COMS/COM/PrepaymentInstructions/PrepaidcodeCarrier> a sh:PropertyShape ;
    era:usedInTelematics true ;
    dcterms:created "2026-10-02T13:08:22+00:00"^^xsd:dateTime ;
    dcterms:references "https://gitlab.com/era-europa-eu/public/era-telematics-tsi/tsi_telematics/-/blob/V4.0.0/TD_105_xsd/taf_cat_complete.xsd"^^xsd:anyURI ;
    sh:class skos:Concept ;
    sh:description "Prepaidcode (given by the railway)"@en ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Prepaidcode carrier"@en ;
    sh:nodeKind sh:IRI ;
    sh:path era:prepaidcodeCarrier ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "The value must be a SKOS concept in the scheme http://data.europa.eu/949/concepts/prepaidcode-carrier/PrepaidcodeCarrier."@en ;
            sh:prefixes "skos:" ;
            sh:select """
                    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
                    SELECT $this
                    WHERE {
                        $this $PATH ?concept .
                        FILTER NOT EXISTS{
                            ?concept skos:inScheme <http://data.europa.eu/949/concepts/prepaidcode-carrier/PrepaidcodeCarrier> .
                        }
                    }
                """ ] .

<http://data.europa.eu/949/shapes/PropertyShape/ConsignmentOrderMessage/COMS/COM/PrepaymentInstructions/PrepaymentCustomer/IncotermCode> a sh:PropertyShape ;
    era:usedInTelematics true ;
    dcterms:created "2026-10-02T13:08:22+00:00"^^xsd:dateTime ;
    dcterms:references "https://gitlab.com/era-europa-eu/public/era-telematics-tsi/tsi_telematics/-/blob/V4.0.0/TD_105_xsd/taf_cat_complete.xsd"^^xsd:anyURI ;
    sh:class skos:Concept ;
    sh:description "Incoterm (given by the client)"@en ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Incoterm code"@en ;
    sh:nodeKind sh:IRI ;
    sh:path era:incotermCode ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "The value must be a SKOS concept in the scheme http://data.europa.eu/949/concepts/incoterm-code/IncotermCode."@en ;
            sh:prefixes "skos:" ;
            sh:select """
                    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
                    SELECT $this
                    WHERE {
