<http://data.europa.eu/949/shapes/NodeShape/CombinedTrafficLoadProfile> a sh:NodeShape ;
    era:usedInTelematics true ;
    dcterms:created "2026-10-02T13:08:22+00:00"^^xsd:dateTime ;
    dcterms:references "https://gitlab.com/era-europa-eu/public/era-telematics-tsi/tsi_telematics/-/blob/V4.0.0/TD_105_xsd/taf_cat_complete.xsd"^^xsd:anyURI ;
    sh:description """This element does refer to combined load units that can be used for Freight Requests only.
There are two entry options:
• One option refers to “P” (Semi-trailer/road semi-trailer):
• The other option refers to “C” (Swap body):
The RUs may indicate the relevant values if they are familiar with the IMs line profiles. In case there is a path request for a train with combined traffic load, the IM should indicate the possible max. value for all 4 elements (P1, P2, C1, C2). Further information about Combined Traffic Load Profile can be seen in the UIC 596-6 Leaflet.
"""@en ;
    sh:name "Combined traffic load profile"@en ;
    sh:nodeKind sh:IRI ;
    sh:property <http://data.europa.eu/949/shapes/PropertyShape/CombinedTrafficLoadProfile/C1>,
        <http://data.europa.eu/949/shapes/PropertyShape/CombinedTrafficLoadProfile/C2>,
        <http://data.europa.eu/949/shapes/PropertyShape/CombinedTrafficLoadProfile/P1>,
        <http://data.europa.eu/949/shapes/PropertyShape/CombinedTrafficLoadProfile/P2> ;
    sh:targetClass era:CombinedTrafficLoadProfile .

