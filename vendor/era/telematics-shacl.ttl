<http://data.europa.eu/949/shapes/PropertyShape/ReturnSearchParameters/arrivalTime> a sh:PropertyShape ;
    era:usedInTelematics true ;
    dcterms:created "2026-10-02T13:09:07+00:00"^^xsd:dateTime ;
    dcterms:references "https://osdm.io/osdm/update/2026/03/25/OSDM-V3.8-released"^^xsd:anyURI ;
    sh:datatype xsd:string ;
    sh:description """Needs to in be local date time format of the stop. Exactly one of `departureTime` or `arrivalTime` must be provided.
"""@en ;
    sh:maxCount 1 ;
    sh:minCount 0 ;
    sh:name "Arrival Time"@en ;
    sh:order 6 ;
    sh:path era:searchArrivalTimeText ;
    sh:pattern "(\\d{4}-[01]\\d-[0-3]\\dT[0-2]\\d:[0-5]\\d:[0-5]\\d)" .

