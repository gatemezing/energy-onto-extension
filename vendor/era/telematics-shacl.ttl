    sh:class skos:Concept ;
    sh:description "ResponseStatus describes the message received status, ACK represents message received successfully and NACK represents message received but rejected"@en ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Response status"@en ;
    sh:nodeKind sh:IRI ;
