<http://data.europa.eu/949/shapes/NodeShape/TrainRunningForecastMessage> a sh:NodeShape ;
    era:usedInTelematics true ;
    dcterms:created "2026-10-02T13:08:22+00:00"^^xsd:dateTime ;
