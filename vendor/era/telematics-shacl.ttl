<http://data.europa.eu/949/shapes/PropertyShape/Ancillary/type> a sh:PropertyShape ;
    era:usedInTelematics true ;
    dcterms:created "2026-10-02T13:09:07+00:00"^^xsd:dateTime ;
    dcterms:references "https://osdm.io/osdm/update/2026/03/25/OSDM-V3.8-released"^^xsd:anyURI ;
    sh:class skos:Concept ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Type"@en ;
    sh:nodeKind sh:IRI ;
    sh:order 2 ;
    sh:path era:assignedType ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "The value must be a SKOS concept in the scheme http://data.europa.eu/949/concepts/ancillary-type/AncillaryType."@en ;
            sh:select """
                PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
                SELECT $this WHERE {
                    $this $PATH ?concept .
                    FILTER NOT EXISTS { ?concept skos:inScheme <http://data.europa.eu/949/concepts/ancillary-type/AncillaryType> . }
                }
            """ ] .

