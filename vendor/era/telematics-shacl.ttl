<http://data.europa.eu/949/shapes/PropertyShape/Length/Measure> a sh:PropertyShape ;
    era:usedInTelematics true ;
    dcterms:created "2026-10-02T13:08:22+00:00"^^xsd:dateTime ;
    dcterms:references "https://gitlab.com/era-europa-eu/public/era-telematics-tsi/tsi_telematics/-/blob/V4.0.0/TD_105_xsd/taf_cat_complete.xsd"^^xsd:anyURI ;
    sh:class skos:Concept ;
    sh:description "Measure used, either ft or mm"@en ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Measure"@en ;
    sh:nodeKind sh:IRI ;
    sh:path era:measureDimension ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "The value must be a SKOS concept in the scheme http://data.europa.eu/949/concepts/measure-dimension/MeasureDimension."@en ;
            sh:prefixes "skos:" ;
            sh:select """
                    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
                    SELECT $this
                    WHERE {
                        $this $PATH ?concept .
                        FILTER NOT EXISTS{
                            ?concept skos:inScheme <http://data.europa.eu/949/concepts/measure-dimension/MeasureDimension> .
                        }
                    }
                """ ] .

