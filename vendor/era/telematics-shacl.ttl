    dcterms:references "https://osdm.io/osdm/update/2026/03/25/OSDM-V3.8-released"^^xsd:anyURI ;
    sh:class skos:Concept ;
    sh:description """Defines the segmentation of the time frame for the offer overview. The default is DAY, which means that one price offer overview is given for 
each day of the requested time frame (provided there aren't more than one travel classes or flexibilities for one time segment).
"""@en ;
    sh:maxCount 1 ;
    sh:minCount 0 ;
    sh:name "Time Frame Segmentation"@en ;
    sh:nodeKind sh:IRI ;
    sh:order 5 ;
    sh:path era:timeFrameSegmentation ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "The value must be a SKOS concept in the scheme http://data.europa.eu/949/concepts/time-frame-segmentation/TimeFrameSegmentation."@en ;
            sh:select """
                PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
                SELECT $this WHERE {
                    $this $PATH ?concept .
                    FILTER NOT EXISTS { ?concept skos:inScheme <http://data.europa.eu/949/concepts/time-frame-segmentation/TimeFrameSegmentation> . }
                }
            """ ] .

