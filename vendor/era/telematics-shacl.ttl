                    SELECT $this
                    WHERE {
                        $this $PATH ?concept .
                        FILTER NOT EXISTS{
                            ?concept skos:inScheme <http://data.europa.eu/949/concepts/price-scope-type/PriceScopeType> .
                        }
                    }
                """ ] .

