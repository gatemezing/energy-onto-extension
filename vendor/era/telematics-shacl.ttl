    sh:class skos:Concept ;
    sh:description """code of the position of the places: 
   W = window
   A  = aile / gangway
   M  = middle / middle level
   I  =  isolated window
   U =  upper level (berth, couchette)
   L =  lower level (berth, couchette)
"""@en ;
