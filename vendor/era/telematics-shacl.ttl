    dcterms:references "https://gitlab.com/era-europa-eu/public/era-telematics-tsi/tsi_telematics/-/blob/V4.0.0/TD_B12_asn1/"^^xsd:anyURI ;
    sh:class skos:Concept ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Class Code"@en ;
    sh:nodeKind sh:IRI ;
    sh:path era:classCode ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "The value must be a SKOS concept in the scheme http://data.europa.eu/949/concepts/travel-class-type/TravelClassType."@en ;
            sh:select """
            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
            SELECT $this WHERE {
                $this $PATH ?concept .
                FILTER NOT EXISTS { ?concept skos:inScheme <http://data.europa.eu/949/concepts/travel-class-type/TravelClassType> . }
            }
        """ ] .

