<http://data.europa.eu/949/shapes/NodeShape/FareConnectionPoint> a sh:NodeShape ;
    era:usedInTelematics true ;
    dcterms:created "2026-10-02T13:09:07+00:00"^^xsd:dateTime ;
    dcterms:references "https://osdm.io/osdm/update/2026/03/25/OSDM-V3.8-released"^^xsd:anyURI ;
    sh:description """Connection point connecting two fare regimes. The connection is possible between stations of the two provided station sets.
A legacy border point code (id) might be provided as an additional code within the stations (code list BORDER_POINT provided in URN).
In case the connection point is a real station this station is indicated.
In case the connection point is between stations for each side of the border real stations must be provided.
Multiple sets of station can be provided in the rare case that the connection point connects more than two station (A-B and A-C).
Multiple stations within a set at one side of the border might be provided in case of changes (new stations build near the border).

Providing the UIC code for the station is mandatory.
"""@en ;
    sh:name "Fare Connection Point"@en ;
    sh:nodeKind sh:IRI ;
    sh:property <http://data.europa.eu/949/shapes/PropertyShape/FareConnectionPoint/name>,
        <http://data.europa.eu/949/shapes/PropertyShape/FareConnectionPoint/nameTranslations>,
        <http://data.europa.eu/949/shapes/PropertyShape/FareConnectionPoint/stationSets> ;
    sh:targetClass era:FareConnectionPoint .

