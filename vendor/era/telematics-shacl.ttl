<http://data.europa.eu/949/shapes/PropertyShape/GNSS_DynamicPosition/SignalQuality/NumberOfVisibleSatellites> a sh:PropertyShape ;
    era:usedInTelematics true ;
    dcterms:created "2026-10-02T13:08:22+00:00"^^xsd:dateTime ;
    dcterms:references "https://gitlab.com/era-europa-eu/public/era-telematics-tsi/tsi_telematics/-/blob/V4.0.0/TD_105_xsd/taf_cat_complete.xsd"^^xsd:anyURI ;
    sh:datatype xsd:integer ;
    sh:description "Indicates the number of satellites being used in the position solution. Greater value indicates better quality."@en ;
    sh:maxCount 1 ;
